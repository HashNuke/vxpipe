import React from "react"
import { Trash2 } from "lucide-react"

import { useTranslation } from "../../i18n"
import { Button } from "../../ui"
import { InspectorRow, InspectorShell } from "./inspector-primitives"

export function SelectedEdgeInspector({ selectedEdge, onDeleteEdge }) {
  const { t } = useTranslation()

  return (
    <InspectorShell title="Selected edge" subtitle={selectedEdge.label || "Workflow transition"}>
      <div className="space-y-4">
        <dl className="space-y-3 text-sm">
          <InspectorRow label="Trigger" value={selectedEdge.data?.trigger || selectedEdge.label || "Manual connection"} />
          <InspectorRow label="Source" value={selectedEdge.source} />
          <InspectorRow label="Target" value={selectedEdge.target} />
          <InspectorRow label="Required variables" value={(selectedEdge.data?.requiredContext || []).join(", ") || "None"} />
        </dl>
        <Button variant="secondary" size="sm" className="w-full justify-start text-rose-700 hover:text-rose-800" onClick={() => onDeleteEdge(selectedEdge.id)}>
          <Trash2 className="h-4 w-4" />
          {t("flowEditor.actions.deleteEdge")}
        </Button>
      </div>
    </InspectorShell>
  )
}
