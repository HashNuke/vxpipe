import React from "react"
import { ArrowLeft, MessageSquareText, Pencil, PhoneCall, Rocket, Save } from "lucide-react"

import { Input } from "@/components/ui/input"
import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "@/components/ui/dialog"

import { Button } from "../../ui"

export function FlowEditorHeader({
  backHref,
  flowName,
  saving,
  publishing = false,
  loading,
  layout = "canvas",
  backLabel = "Back to flows",
  editNameLabel = "Edit flow name",
  titleFallback = "Flow editor",
  saveDraftLabel = "Save draft",
  savingLabel = "Saving",
  publishLabel = "Publish",
  publishingLabel = "Publishing",
  testCallLabel = "Test call",
  testchatLabel = "Testchat",
  onEditFlowName,
  onSaveDraft,
  onPublish,
  onOpenTestCall,
  onOpenTestchat
}) {
  return (
    <div
      data-flow-editor-header
      className={[
        "z-10 flex min-h-11 items-center justify-between gap-3 rounded-md border border-border bg-background/95 px-3 py-2 shadow-sm backdrop-blur",
        layout === "settings"
          ? "relative"
          : "absolute left-4 right-4 top-2 lg:right-[calc(34rem+0.75rem)] lg:left-3 lg:top-3"
      ].join(" ")}
    >
      <div className="flex min-w-0 items-center gap-2">
        <Button asChild variant="secondary" size="icon" className="h-8 w-8 shrink-0" aria-label={backLabel}>
          <a href={backHref} aria-label={backLabel}>
            <ArrowLeft className="h-4 w-4" />
          </a>
        </Button>
        <div className="min-w-0">
          <h1 className="sr-only">{flowName || titleFallback}</h1>
          <button
            type="button"
            className="-ml-1 flex max-w-full items-center gap-2 rounded-md px-1.5 py-1 text-left text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            onClick={onEditFlowName}
            aria-label={editNameLabel}
          >
            <span className="min-w-0 truncate">{flowName || titleFallback}</span>
            <Pencil className="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
          </button>
        </div>
      </div>
      <div className="flex shrink-0 items-center gap-2">
        {onOpenTestCall && (
          <Button variant="secondary" size="sm" className="h-8 px-3" onClick={onOpenTestCall} disabled={loading}>
            <PhoneCall className="h-4 w-4" />
            {testCallLabel}
          </Button>
        )}
        {onOpenTestchat && (
          <Button variant="secondary" size="sm" className="h-8 px-3" onClick={onOpenTestchat} disabled={loading || saving}>
            <MessageSquareText className="h-4 w-4" />
            {testchatLabel}
          </Button>
        )}
        <Button variant="secondary" size="sm" className="h-8 px-3" onClick={onSaveDraft} disabled={saving || loading || publishing}>
          <Save className="h-4 w-4" />
          {saving ? savingLabel : saveDraftLabel}
        </Button>
        <Button size="sm" className="h-8 px-3" onClick={onPublish} disabled={saving || loading || publishing}>
          <Rocket className="h-4 w-4" />
          {publishing ? publishingLabel : publishLabel}
        </Button>
      </div>
    </div>
  )
}

export function FlowNameDialog({
  open,
  value,
  title = "Edit flow name",
  nameLabel = "Flow name",
  cancelLabel = "Cancel",
  saveLabel = "Save",
  onValueChange,
  onCancel,
  onSubmit
}) {
  return (
    <Dialog open={open} onOpenChange={(nextOpen) => !nextOpen && onCancel()}>
      <DialogContent className="sm:max-w-md">
        <form onSubmit={onSubmit} className="space-y-4">
          <DialogHeader>
            <DialogTitle>{title}</DialogTitle>
          </DialogHeader>
          <Input
            value={value}
            autoFocus
            onChange={(event) => onValueChange(event.target.value)}
            aria-label={nameLabel}
          />
          <DialogFooter>
            <Button variant="secondary" type="button" onClick={onCancel}>
              {cancelLabel}
            </Button>
            <Button type="submit">
              {saveLabel}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  )
}
