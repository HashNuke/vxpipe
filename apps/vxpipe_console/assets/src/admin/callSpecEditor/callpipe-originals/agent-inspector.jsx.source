import React, { useCallback, useEffect, useMemo, useState } from "react"
import { ArrowDown, ArrowLeft, ArrowUp, Bot, Check, CircleAlert, FileText, GitBranch, KeyRound, Plus, RefreshCw, Search, ShieldCheck, Trash2, Variable, XCircle } from "lucide-react"

import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import { Input } from "@/components/ui/input"
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "@/components/ui/item"
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover"
import { Skeleton } from "@/components/ui/skeleton"
import { Switch } from "@/components/ui/switch"
import { cn as cx } from "@/lib/utils"

import { useTranslation } from "../../i18n"
import { Badge, Button } from "../../ui"
import { ANY_TRANSFER_DESTINATION, isAllowedTransferTargetNode, removeTransferDestinationFromData, upsertTransferDestination } from "./flow-definition"
import { collectedVariables, countItems, visibleNodeSubtitle } from "./display-helpers"
import { FieldLabel } from "./inspector-primitives"
import { knowledgeIcon, knowledgeOptions } from "./knowledge"
import { LexicalPromptEditor } from "./prompt-editor"
import { ResourceSelectionFlow, sharedResourceSelection } from "../../resource-selection"
import { loadFlowProviderResourceOptions, loadFlowProviderTools, loadFlowToolServices } from "./api"
import { VariableRetentionControl } from "./variable-retention-control"

const sidebarControlClass = "border-border/70 bg-muted/30 shadow-none focus-visible:ring-1"
const sidebarSelectClass = "h-9 rounded-md border border-border/70 bg-muted/30 px-2 text-sm shadow-none outline-none transition-colors focus:ring-1 focus:ring-ring"

const tabLabels = [
  { id: "system", label: "System prompt" },
  { id: "variables", label: "Variables" },
  { id: "transfers", label: "Transfers" },
  { id: "tools", label: "Tools" },
  { id: "knowledge", label: "Knowledge" }
]

const variableTypes = ["text", "number", "boolean", "date", "time", "phone", "email", "enum"]

function agentNodes(nodes) {
  return nodes.filter((candidate) => candidate.data?.kind === "agent")
}



function transferTargetNodes(nodes) {
  return nodes.filter(isAllowedTransferTargetNode)
}

function agentLabel(nodes, agentId) {
  if (agentId === ANY_TRANSFER_DESTINATION) return "Any node"
  return nodes.find((candidate) => candidate.id === agentId)?.data?.label || agentId
}

function variableLabel(nodes, agentId, variableKey) {
  const sourceAgent = nodes.find((candidate) => candidate.id === agentId)
  const variable = collectedVariables(sourceAgent?.data || {}).find((candidate) => candidate.key === variableKey)
  return variable?.label || variableKey
}

function underscorizeVariableName(value) {
  return (value || "variable")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "")
    || "variable"
}

function uniqueVariableKey(existingVariables, label) {
  const baseKey = underscorizeVariableName(label)
  let key = baseKey
  let index = 2

  while (existingVariables.some((variable) => variable.key === key)) {
    key = `${baseKey}_${index}`
    index += 1
  }

  return key
}

function nextVariableLabel(existingVariables) {
  let index = existingVariables.length + 1
  let label = `New variable ${index}`

  while (existingVariables.some((variable) => variable.label === label)) {
    index += 1
    label = `New variable ${index}`
  }

  return label
}

function toolLinkSlug(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
}

function nextNodeToolLinkId(nodeId, toolLinks) {
  const baseId = toolLinkSlug(["tool-link", "node", nodeId].join("-")) || "tool-link-node"
  let index = 1
  let id = `${baseId}-${index}`

  while (toolLinks.some((link) => link.id === id)) {
    index += 1
    id = `${baseId}-${index}`
  }

  return id
}

function titleizeToolId(toolId) {
  return String(toolId || "")
    .split(/[_\s-]+/)
    .filter(Boolean)
    .map((part) => `${part.charAt(0).toUpperCase()}${part.slice(1)}`)
    .join(" ")
}

function grantedToolSummaries(definition, data) {
  const linksById = new Map((definition?.toolLinks || []).map((link) => [link.id, link]))

  return (data.toolGrants || []).flatMap((grant) => {
    const link = linksById.get(grant.toolLinkId)
    if (!link) return []

    return (grant.tools || []).map((toolId) => ({
      id: `${grant.toolLinkId}:${toolId}`,
      toolId,
      label: link.toolLabelSnapshots?.[toolId] || titleizeToolId(toolId),
      providerType: link.providerType,
      connectionLabel: link.connectionLabelSnapshot || `Connection ${link.connectionId}`,
      resourceSummary: (link.resourcePath || []).map((entry) => entry.labelSnapshot || entry.id).filter(Boolean).join(" / "),
      link
    }))
  })
}

export function AgentInspector({ organizationId, workspaceId, flowId, definition, node, allNodes, updateDefinition, updateNodeData, onDeleteNode, canDeleteNode, onAddTransferDestination, onRemoveTransferDestination }) {
  const { t } = useTranslation()
  const [activeTab, setActiveTab] = useState("system")
  const [addToolsOpen, setAddToolsOpen] = useState(false)
  const [knowledgeOpen, setKnowledgeOpen] = useState(false)
  const [knowledgeQuery, setKnowledgeQuery] = useState("")
  const [variableAccessOpen, setVariableAccessOpen] = useState(false)
  const [transferOpen, setTransferOpen] = useState(false)
  const [transferQuery, setTransferQuery] = useState("")
  const data = node.data
  const grantedTools = grantedToolSummaries(definition, data)
  const knowledge = data.knowledge || { inheritCommon: true, grants: [] }
  const variables = collectedVariables(data)
  const variableAccess = data.variableAccess || []
  const transfers = data.transfers || { allowedDestinations: [] }
  const allowedDestinations = transfers.allowedDestinations || []
  const otherAgents = agentNodes(allNodes).filter((candidate) => candidate.id !== node.id)
  const transferTargets = transferTargetNodes(allNodes).filter((candidate) => candidate.id !== node.id)
  const transferQueryText = transferQuery.trim().toLowerCase()
  const filteredTransferTargets = transferTargets.filter((candidate) => {
    if (!transferQueryText) return true
    return `${candidate.data?.label || ""} ${candidate.id}`.toLowerCase().includes(transferQueryText)
  })
  const hasAnyTransfer = allowedDestinations.some((destination) => destination.agentId === ANY_TRANSFER_DESTINATION)
  const anyTransferLabel = t("flowEditor.transfers.anyNode")
  const anyTransferDescription = t("flowEditor.transfers.anyNodeDescription")
  const showAnyTransferOption =
    !hasAnyTransfer &&
    `${anyTransferLabel} ${anyTransferDescription}`.toLowerCase().includes(transferQueryText)
  const availableTransferTargets = filteredTransferTargets.filter(
    (agent) => !allowedDestinations.some((destination) => destination.agentId === agent.id)
  )
  const transferDestinationLabel = (agentId) =>
    agentId === ANY_TRANSFER_DESTINATION ? anyTransferLabel : agentLabel(allNodes, agentId)
  const filteredKnowledgeOptions = knowledgeOptions.filter((option) => {
    const query = knowledgeQuery.trim().toLowerCase()
    if (!query) return true
    return `${option.label} ${option.description}`.toLowerCase().includes(query)
  })

  const updateVariables = (nextVariables) => updateNodeData(node.id, { variables: nextVariables })
  const updateVariable = (variableKey, updates) => {
    updateVariables(variables.map((variable) => variable.key === variableKey ? { ...variable, ...updates } : variable))
  }
  const updateVariableLabel = (variableKey, label) => {
    updateVariables(variables.map((variable) => {
      if (variable.key !== variableKey) return variable
      const otherVariables = variables.filter((candidate) => candidate.key !== variableKey)
      return { ...variable, label, key: uniqueVariableKey(otherVariables, label) }
    }))
  }

  const addCollectedVariable = () => {
    const label = nextVariableLabel(variables)
    updateVariables([
      ...variables,
      {
        key: uniqueVariableKey(variables, label),
        label,
        type: "text",
        required: false
      }
    ])
  }

  const removeCollectedVariable = (variableKey) => {
    updateVariables(variables.filter((variable) => variable.key !== variableKey))
  }

  const moveCollectedVariable = (variableKey, direction) => {
    const currentIndex = variables.findIndex((variable) => variable.key === variableKey)
    const nextIndex = currentIndex + direction
    if (currentIndex < 0 || nextIndex < 0 || nextIndex >= variables.length) return

    const nextVariables = [...variables]
    const [variable] = nextVariables.splice(currentIndex, 1)
    nextVariables.splice(nextIndex, 0, variable)
    updateVariables(nextVariables)
  }

  const addVariableAccessGrant = (grant) => {
    const alreadyGranted = variableAccess.some((existingGrant) => {
      if (existingGrant.type !== grant.type || existingGrant.agentId !== grant.agentId) return false
      return grant.type === "agent_group" || existingGrant.key === grant.key
    })
    if (alreadyGranted) return
    updateNodeData(node.id, { variableAccess: [...variableAccess, grant] })
    setVariableAccessOpen(false)
  }

  const removeVariableAccessGrant = (grant) => {
    updateNodeData(node.id, {
      variableAccess: variableAccess.filter((existingGrant) => {
        if (existingGrant.type !== grant.type || existingGrant.agentId !== grant.agentId) return true
        return grant.type === "variable" && existingGrant.key !== grant.key
      })
    })
  }

  const updateTransfers = (nextTransfers) => updateNodeData(node.id, { transfers: nextTransfers })
  const addTransferDestination = (agentId) => {
    if (agentId === node.id) return
    if (allowedDestinations.some((destination) => destination.agentId === agentId)) return
    const nextData = upsertTransferDestination(data, agentId, { requiresVisibleEdge: agentId !== ANY_TRANSFER_DESTINATION })
    updateNodeData(node.id, { transfers: nextData.transfers })
    onAddTransferDestination?.(node.id, agentId)
    setTransferQuery("")
    setTransferOpen(false)
  }

  const updateTransferDestination = (agentId, updates) => {
    updateTransfers({
      ...transfers,
      allowedDestinations: (transfers.allowedDestinations || []).map((destination) =>
        destination.agentId === agentId ? { ...destination, ...updates } : destination
      )
    })
  }

  const removeTransferDestination = (agentId) => {
    const nextData = removeTransferDestinationFromData(data, agentId)
    updateNodeData(node.id, { transfers: nextData.transfers })
    onRemoveTransferDestination?.(node.id, agentId)
  }

  const addKnowledgeGrant = (option) => {
    const grants = knowledge.grants || []
    if (grants.some((grant) => grant.id === option.id)) return
    updateNodeData(node.id, {
      knowledge: {
        ...knowledge,
        grants: [...grants, option]
      }
    })
    setKnowledgeOpen(false)
    setKnowledgeQuery("")
  }

  const removeKnowledgeGrant = (grantId) => {
    updateNodeData(node.id, {
      knowledge: {
        ...knowledge,
        grants: (knowledge.grants || []).filter((grant) => grant.id !== grantId)
      }
    })
  }

  const removeToolGrant = (toolLinkId) => {
    const nextToolGrants = (data.toolGrants || []).filter((grant) => grant.toolLinkId !== toolLinkId)
    const nextNodes = (definition?.nodes || []).map((candidate) =>
      candidate.id === node.id
        ? { ...candidate, data: { ...(candidate.data || {}), toolGrants: nextToolGrants } }
        : candidate
    )
    const stillGranted = nextNodes.some((candidate) =>
      (candidate.data?.toolGrants || []).some((grant) => grant.toolLinkId === toolLinkId)
    )

    updateNodeData(node.id, {
      toolGrants: nextToolGrants
    })

    if (!stillGranted && String(toolLinkId).startsWith("tool-link-node-")) {
      updateDefinition({
        toolLinks: (definition?.toolLinks || []).filter((link) => link.id !== toolLinkId)
      })
    }
  }

  return (
    <aside className="flex h-full min-h-0 w-full flex-col overflow-hidden bg-background">
      <div className="p-4 pb-2">
        <div className="flex items-center justify-between gap-3 text-xs font-medium uppercase tracking-wide text-muted-foreground">
          <div className="flex items-center gap-2">
            <Bot className="h-3.5 w-3.5" />
            <span>Agent name</span>
          </div>
          <div className="flex items-center gap-2">
            {canDeleteNode && (
              <button
                type="button"
                className="inline-flex h-7 w-7 items-center justify-center rounded-md text-slate-400 transition hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950"
                aria-label={t("flowEditor.actions.deleteNode")}
                onClick={() => onDeleteNode(node.id)}
              >
                <Trash2 className="h-4 w-4" />
              </button>
            )}
          </div>
        </div>
        <Input
          className={cx("mt-2", sidebarControlClass)}
          value={data.label}
          onChange={(event) => updateNodeData(node.id, { label: event.target.value, name: event.target.value })}
          aria-label="Agent name"
        />
      </div>

      <div className="flex min-h-0 flex-1 flex-col">
        <div className="overflow-x-auto border-b border-slate-200 px-4">
          <div role="tablist" aria-label="Agent settings" className="flex h-auto justify-start gap-1 rounded-none bg-transparent p-0 text-slate-500">
            {tabLabels.map((tab) => (
              <button
                key={tab.id}
                type="button"
                role="tab"
                aria-selected={activeTab === tab.id}
                className={cx(
                  "rounded-none border-b-2 bg-transparent px-3 py-3 text-sm font-medium shadow-none transition hover:text-slate-950",
                  activeTab === tab.id
                    ? "border-slate-950 text-slate-950"
                    : "border-transparent text-slate-500"
                )}
                onClick={() => setActiveTab(tab.id)}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>

        {activeTab === "system" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-hidden p-4">
          <div className="flex h-full min-h-0 flex-col gap-4">
            <Item asChild variant="muted" size="sm">
              <label>
                <ItemMedia>
                  <Switch
                    checked={data.includeCommonPrompt ?? true}
                    onCheckedChange={(checked) => updateNodeData(node.id, { includeCommonPrompt: checked })}
                    aria-label="Prepend common system prompt"
                  />
                </ItemMedia>
                <ItemContent>
                  <ItemTitle>Prepend common system prompt</ItemTitle>
                </ItemContent>
              </label>
            </Item>
            <div className="flex min-h-0 flex-1 flex-col">
              <FieldLabel>Agent-specific system prompt</FieldLabel>
              <div className="mt-2 min-h-0 flex-1">
                <LexicalPromptEditor
                  key={node.id}
                  editorKey={node.id}
                  value={data.systemPrompt || ""}
                  onChange={(systemPrompt) => updateNodeData(node.id, { systemPrompt })}
                  className="h-full min-h-0"
                />
              </div>
            </div>
          </div>
        </div>
        )}

        {activeTab === "variables" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-5">
            <section className="space-y-3">
              <div className="flex items-center justify-between gap-3">
                <div>
                  <FieldLabel>Variables this agent can access</FieldLabel>
                  <p className="mt-1 text-xs leading-5 text-muted-foreground">
                    Grant read-only context from earlier agents as a whole group or one variable at a time.
                  </p>
                </div>
                <Popover open={variableAccessOpen} onOpenChange={setVariableAccessOpen}>
                  <PopoverTrigger asChild>
                    <Button variant="secondary" size="sm" type="button">
                      <Plus className="h-4 w-4" />
                      Add
                    </Button>
                  </PopoverTrigger>
                  <PopoverContent align="end" className="w-[25rem] p-2">
                    <div className="max-h-80 overflow-auto">
                      {otherAgents.map((agent) => {
                        const sourceVariables = collectedVariables(agent.data)
                        return (
                          <div key={agent.id} className="rounded-md p-2">
                            <div className="flex items-start justify-between gap-3">
                              <div>
                                <div className="text-sm font-semibold text-foreground">{agent.data.label}</div>
                                <div className="text-xs text-muted-foreground">{sourceVariables.length} variables</div>
                              </div>
                              <Button
                                variant="secondary"
                                size="sm"
                                type="button"
                                onClick={() => addVariableAccessGrant({ type: "agent_group", agentId: agent.id })}
                              >
                                All
                              </Button>
                            </div>
                            <div className="mt-2 space-y-1">
                              {sourceVariables.map((variable) => (
                                <button
                                  key={variable.key}
                                  type="button"
                                  className="flex w-full items-center justify-between gap-3 rounded-md px-2 py-1.5 text-left text-sm hover:bg-muted"
                                  onClick={() => addVariableAccessGrant({ type: "variable", agentId: agent.id, key: variable.key })}
                                >
                                  <span>
                                    <span className="block font-medium text-foreground">{variable.label}</span>
                                    <span className="text-xs text-muted-foreground">{variable.key} · {variable.type}</span>
                                  </span>
                                  <Plus className="h-3.5 w-3.5 text-muted-foreground" />
                                </button>
                              ))}
                            </div>
                          </div>
                        )
                      })}
                      {otherAgents.length === 0 && (
                        <div className="px-3 py-6 text-center text-sm text-muted-foreground">
                          Add another agent before granting variable access.
                        </div>
                      )}
                    </div>
                  </PopoverContent>
                </Popover>
              </div>

              <ItemGroup className="rounded-md border border-border/60">
                {variableAccess.map((grant) => (
                  <React.Fragment key={`${grant.type}-${grant.agentId}-${grant.key || "all"}`}>
                    <Item size="sm">
                      <ItemMedia variant="icon">
                        {grant.type === "agent_group" ? <ShieldCheck /> : <KeyRound />}
                      </ItemMedia>
                      <ItemContent>
                        <ItemTitle>
                          {grant.type === "agent_group"
                            ? `All variables from ${agentLabel(allNodes, grant.agentId)}`
                            : variableLabel(allNodes, grant.agentId, grant.key)}
                        </ItemTitle>
                        <ItemDescription>
                          {grant.type === "agent_group"
                            ? "Dynamic group grant"
                            : `${grant.key} from ${agentLabel(allNodes, grant.agentId)}`}
                        </ItemDescription>
                      </ItemContent>
                      <ItemActions>
                        <button
                          type="button"
                          className="text-muted-foreground hover:text-foreground"
                          aria-label="Remove variable access"
                          onClick={() => removeVariableAccessGrant(grant)}
                        >
                          <Trash2 className="h-4 w-4" />
                        </button>
                      </ItemActions>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                ))}
                {variableAccess.length === 0 && (
                  <div className="px-4 py-6 text-center">
                    <div className="mx-auto flex h-9 w-9 items-center justify-center rounded-md bg-muted text-muted-foreground">
                      <Variable className="h-4 w-4" />
                    </div>
                    <div className="mt-3 text-sm font-medium text-foreground">No external variables yet</div>
                    <p className="mx-auto mt-1 max-w-xs text-sm leading-6 text-muted-foreground">
                      Grant access when this agent should use context collected by another agent.
                    </p>
                  </div>
                )}
              </ItemGroup>
            </section>

            <section className="space-y-3">
              <div className="flex items-center justify-between gap-3">
                <div>
                  <FieldLabel>Variables this agent collects</FieldLabel>
                </div>
                <Button variant="secondary" size="sm" type="button" onClick={addCollectedVariable}>
                  <Plus className="h-4 w-4" />
                  Add
                </Button>
              </div>

              <div className="space-y-2">
                {variables.map((variable, index) => (
                  <div key={variable.key} className="rounded-md border border-border/70 bg-card p-3">
                    <div className="grid gap-2 sm:grid-cols-[minmax(0,1fr)_8rem]">
                      <div className="min-w-0">
                        <Input
                          className={sidebarControlClass}
                          value={variable.label}
                          onChange={(event) => updateVariableLabel(variable.key, event.target.value)}
                          aria-label={`${variable.key} label`}
                        />
                      </div>
                      <select
                        value={variable.type}
                        onChange={(event) => updateVariable(variable.key, { type: event.target.value })}
                        className={sidebarSelectClass}
                        aria-label={`${variable.label} type`}
                      >
                        {variableTypes.map((type) => <option key={type} value={type}>{type}</option>)}
                      </select>
                    </div>
                    <div className="mt-2 flex flex-wrap items-center gap-2">
                      <button
                        type="button"
                        className={cx(
                          "flex h-9 w-9 items-center justify-center rounded-md border transition",
                          variable.required
                            ? "border-amber-300 bg-amber-50 text-amber-700"
                            : "border-border bg-background text-muted-foreground hover:bg-muted hover:text-foreground"
                        )}
                        aria-pressed={variable.required || false}
                        aria-label={`${variable.label} required`}
                        title="Required"
                        onClick={() => updateVariable(variable.key, { required: !variable.required })}
                      >
                        <CircleAlert className="h-4 w-4" />
                      </button>
                      <VariableRetentionControl
                        variable={variable}
                        t={t}
                        onChange={(updates) => updateVariable(variable.key, updates)}
                      />
                      <button
                        type="button"
                        className="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                        aria-label={`Move ${variable.label} up`}
                        disabled={index === 0}
                        onClick={() => moveCollectedVariable(variable.key, -1)}
                      >
                        <ArrowUp className="h-4 w-4" />
                      </button>
                      <button
                        type="button"
                        className="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                        aria-label={`Move ${variable.label} down`}
                        disabled={index === variables.length - 1}
                        onClick={() => moveCollectedVariable(variable.key, 1)}
                      >
                        <ArrowDown className="h-4 w-4" />
                      </button>
                      <button
                        type="button"
                        className="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-foreground"
                        aria-label={`Remove ${variable.label}`}
                        onClick={() => removeCollectedVariable(variable.key)}
                      >
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                ))}
                {variables.length === 0 && (
                  <div className="rounded-md border border-dashed border-border p-6 text-center text-sm text-muted-foreground">
                    Add the first variable this agent should collect.
                  </div>
                )}
              </div>
            </section>
          </div>
        </div>
        )}

        {activeTab === "transfers" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <div className="flex items-center justify-between gap-3">
              <div>
                <FieldLabel>Allowed destinations</FieldLabel>
              </div>
              <Popover open={transferOpen} onOpenChange={setTransferOpen}>
                <PopoverTrigger asChild>
                  <Button variant="secondary" size="sm" type="button">
                    <Plus className="h-4 w-4" />
                    Add
                  </Button>
                </PopoverTrigger>
                <PopoverContent align="end" className="w-80 p-2">
                  <div className="mb-2 flex items-center gap-2 rounded-md border border-border/70 bg-background px-2">
                    <Search className="h-4 w-4 text-muted-foreground" />
                    <input
                      value={transferQuery}
                      onChange={(event) => setTransferQuery(event.target.value)}
                      placeholder={t("flowEditor.transfers.searchPlaceholder")}
                      className="h-9 min-w-0 flex-1 bg-transparent text-sm outline-none"
                      aria-label={t("flowEditor.transfers.searchPlaceholder")}
                    />
                  </div>
                  {showAnyTransferOption && (
                    <button
                      type="button"
                      className="flex w-full items-start gap-3 rounded-md px-2 py-2 text-left text-sm hover:bg-muted"
                      onClick={() => addTransferDestination(ANY_TRANSFER_DESTINATION)}
                    >
                      <GitBranch className="mt-0.5 h-4 w-4 text-muted-foreground" />
                      <span>
                        <span className="block font-medium text-foreground">{anyTransferLabel}</span>
                        <span className="text-xs text-muted-foreground">{anyTransferDescription}</span>
                      </span>
                    </button>
                  )}
                  {availableTransferTargets.map((agent) => (
                    <button
                      key={agent.id}
                      type="button"
                      className="flex w-full items-start gap-3 rounded-md px-2 py-2 text-left text-sm hover:bg-muted"
                      onClick={() => addTransferDestination(agent.id)}
                    >
                      <Bot className="mt-0.5 h-4 w-4 text-muted-foreground" />
                      <span>
                        <span className="block font-medium text-foreground">{agent.data.label}</span>
                        {visibleNodeSubtitle(agent.data) && (
                          <span className="text-xs text-muted-foreground">{visibleNodeSubtitle(agent.data)}</span>
                        )}
                      </span>
                    </button>
                  ))}
                  {!showAnyTransferOption && availableTransferTargets.length === 0 && (
                    <div className="px-3 py-6 text-center text-sm text-muted-foreground">
                      {t("flowEditor.transfers.noMatches")}
                    </div>
                  )}
                </PopoverContent>
              </Popover>
            </div>

            <div className="space-y-2">
              {(transfers.allowedDestinations || []).map((destination) => {
                const targetAgent = allNodes.find((candidate) => candidate.id === destination.agentId)
                const acceptance = targetAgent?.data?.transferAcceptance || {}
                return (
                  <div key={destination.agentId} className="rounded-md border border-border/70 bg-card p-3">
                    <div className="flex items-start justify-between gap-3">
                      <div className="min-w-0">
                        <div className="truncate text-sm font-semibold text-foreground">{transferDestinationLabel(destination.agentId)}</div>
                        <div className="mt-1 text-xs text-muted-foreground">
                          Requires {(acceptance.requiredVariables || []).length || 0} variables · {acceptance.missingRequiredBehavior || "warn"} if missing
                        </div>
                      </div>
                      <button
                        type="button"
                        className="rounded-md p-1.5 text-muted-foreground transition hover:bg-muted hover:text-foreground"
                        aria-label="Remove transfer destination"
                        onClick={() => removeTransferDestination(destination.agentId)}
                      >
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                    {(acceptance.requiredVariables || []).length > 0 && (
                      <div className="mt-3 flex flex-wrap gap-1.5">
                        {acceptance.requiredVariables.map((variableKey) => (
                          <Badge key={variableKey} tone="purple">{variableKey}</Badge>
                        ))}
                      </div>
                    )}
                    {acceptance.guidance && (
                      <p className="mt-3 rounded-md bg-muted/60 p-2 text-xs leading-5 text-muted-foreground">{acceptance.guidance}</p>
                    )}
                    <Input
                      className={cx("mt-3", sidebarControlClass)}
                      value={destination.instructions || ""}
                      onChange={(event) => updateTransferDestination(destination.agentId, { instructions: event.target.value })}
                      placeholder="When should this agent transfer here?"
                      aria-label={`${transferDestinationLabel(destination.agentId)} transfer instructions`}
                    />
                  </div>
                )
              })}
              {countItems(transfers.allowedDestinations) === 0 && (
                <div className="rounded-md border border-dashed border-border p-6 text-center text-sm text-muted-foreground">
                  Add a destination agent to make transfer_agent available from this agent.
                </div>
              )}
            </div>
          </div>
        </div>
        )}

        {activeTab === "tools" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <div>
              <div className="flex items-center justify-between gap-3">
                <FieldLabel>{t("flowEditor.tools.enabled")}</FieldLabel>
                <Button variant="secondary" size="sm" type="button" onClick={() => setAddToolsOpen(true)}>
                  <Plus className="h-4 w-4" />
                  {t("flowEditor.tools.add")}
                </Button>
              </div>
              <ItemGroup className="mt-2 rounded-md border border-border/60">
                {grantedTools.map((grant) => (
                  <React.Fragment key={grant.id}>
                    <Item size="sm">
                      <ItemMedia variant="icon">
                        <KeyRound />
                      </ItemMedia>
                      <ItemContent>
                        <ItemTitle>{grant.label}</ItemTitle>
                        <ItemDescription>
                          <span className="flex flex-wrap gap-1.5">
                            <span>{grant.providerType}</span>
                            <span>{grant.connectionLabel}</span>
                            {grant.resourceSummary && <span>{grant.resourceSummary}</span>}
                          </span>
                        </ItemDescription>
                      </ItemContent>
                      <ItemActions>
                        <button
                          type="button"
                          className="text-muted-foreground hover:text-foreground"
                          aria-label={t("flowEditor.tools.removeGrant", { tool: grant.label })}
                          onClick={() => removeToolGrant(grant.link.id)}
                        >
                          <Trash2 className="h-4 w-4" />
                        </button>
                      </ItemActions>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                ))}
                {(data.tools || []).map((tool) => (
                  <React.Fragment key={tool}>
                    <Item asChild size="sm">
                      <label>
                        <ItemMedia>
                          <Switch checked onCheckedChange={() => {}} aria-label={`${tool} enabled`} />
                        </ItemMedia>
                        <ItemContent>
                          <ItemTitle>{tool}</ItemTitle>
                        </ItemContent>
                      </label>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                ))}
                {countItems(data.tools) === 0 && grantedTools.length === 0 && (
                  <Item size="sm">
                    <ItemContent>
                      <ItemDescription>{t("flowEditor.tools.empty")}</ItemDescription>
                    </ItemContent>
                  </Item>
                )}
              </ItemGroup>
            </div>
            <div>
              <FieldLabel>MCP access</FieldLabel>
              <ItemGroup className="mt-2 rounded-md border border-border/60">
                {(data.mcps || []).map((mcp) => (
                  <React.Fragment key={mcp.id || mcp}>
                    <Item size="sm">
                      <ItemContent>
                        <ItemTitle>{mcp.label || mcp}</ItemTitle>
                        <ItemDescription>{mcp.description || "MCP capability"}</ItemDescription>
                      </ItemContent>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                ))}
                {countItems(data.mcps) === 0 && (
                  <Item size="sm">
                    <ItemContent>
                      <ItemDescription>No MCPs enabled for this agent.</ItemDescription>
                    </ItemContent>
                  </Item>
                )}
              </ItemGroup>
            </div>
          </div>
          <AddToolsModal
            open={addToolsOpen}
            onOpenChange={setAddToolsOpen}
            organizationId={organizationId}
            workspaceId={workspaceId}
            flowId={flowId}
            node={node}
            definition={definition}
            updateDefinition={updateDefinition}
            updateNodeData={updateNodeData}
            t={t}
          />
        </div>
        )}

        {activeTab === "knowledge" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <Item asChild variant="muted" size="sm">
              <label>
                <ItemMedia>
                  <Switch
                    checked={knowledge.inheritCommon ?? true}
                    onCheckedChange={(checked) => updateNodeData(node.id, { knowledge: { ...knowledge, inheritCommon: checked } })}
                    aria-label="Inherit flow knowledge"
                  />
                </ItemMedia>
                <ItemContent>
                  <ItemTitle>Inherit flow knowledge</ItemTitle>
                </ItemContent>
              </label>
            </Item>

            <Popover open={knowledgeOpen} onOpenChange={setKnowledgeOpen}>
              <PopoverTrigger asChild>
                <Button variant="secondary" type="button" className="w-full">
                  <Plus className="h-4 w-4" />
                  Add files
                </Button>
              </PopoverTrigger>
              <PopoverContent align="start" className="w-[24rem] p-2">
                  <div className="flex items-center gap-2 rounded-md border border-input px-2">
                    <Search className="h-4 w-4 text-muted-foreground" />
                    <input
                      value={knowledgeQuery}
                      onChange={(event) => setKnowledgeQuery(event.target.value)}
                      placeholder="Search files and folders"
                      className="h-9 min-w-0 flex-1 bg-transparent text-sm outline-none"
                    />
                  </div>
                  <div className="mt-2 max-h-56 overflow-auto">
                    {filteredKnowledgeOptions.map((option) => {
                      const OptionIcon = knowledgeIcon(option.type)
                      return (
                        <button
                          key={option.id}
                          type="button"
                          className="flex w-full items-start gap-3 rounded-md px-2 py-2 text-left text-sm hover:bg-muted"
                          onClick={() => addKnowledgeGrant(option)}
                        >
                          <OptionIcon className="mt-0.5 h-4 w-4 text-muted-foreground" />
                          <span>
                            <span className="block font-medium text-foreground">{option.label}</span>
                            <span className="text-xs text-muted-foreground">{option.description}</span>
                          </span>
                        </button>
                      )
                    })}
                  </div>
              </PopoverContent>
            </Popover>

            <ItemGroup className="rounded-md border border-border/60">
              {(knowledge.grants || []).map((grant) => {
                const GrantIcon = knowledgeIcon(grant.type)
                return (
                  <React.Fragment key={grant.id}>
                    <Item size="sm">
                      <ItemMedia variant="icon">
                        <GrantIcon />
                      </ItemMedia>
                      <ItemContent>
                        <ItemTitle>{grant.label}</ItemTitle>
                        <ItemDescription>{grant.description}</ItemDescription>
                      </ItemContent>
                      <ItemActions>
                        <button type="button" className="text-xs font-medium text-muted-foreground hover:text-foreground" onClick={() => removeKnowledgeGrant(grant.id)}>
                          Remove
                        </button>
                      </ItemActions>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                )
              })}
              {countItems(knowledge.grants) === 0 && (
                <div className="px-4 py-6 text-center">
                  <div className="mx-auto flex h-9 w-9 items-center justify-center rounded-md bg-muted text-muted-foreground">
                    <FileText className="h-4 w-4" />
                  </div>
                  <div className="mt-3 text-sm font-medium text-foreground">Using flow knowledge</div>
                  <p className="mx-auto mt-1 max-w-xs text-sm leading-6 text-muted-foreground">
                    This agent can use the shared knowledge set. Add files or folders here when this agent needs specialized context.
                  </p>
                </div>
              )}
            </ItemGroup>
          </div>
        </div>
        )}
      </div>
    </aside>
  )
}

function AddToolsModal({ open, onOpenChange, organizationId, workspaceId, flowId, node, definition, updateDefinition, updateNodeData, t }) {
  const [services, setServices] = useState([])
  const [selectedService, setSelectedService] = useState(null)
  const [selectedConnection, setSelectedConnection] = useState(null)
  const [selectedContext, setSelectedContext] = useState(null)
  const [tools, setTools] = useState([])
  const [selectedToolIds, setSelectedToolIds] = useState([])
  const [resourcePath, setResourcePath] = useState([])
  const [loading, setLoading] = useState(false)
  const [toolsLoading, setToolsLoading] = useState(false)
  const [error, setError] = useState(null)
  const [toolsError, setToolsError] = useState(null)
  const canLoad = Boolean(organizationId && workspaceId && flowId)

  const loadServices = () => {
    if (!open || !canLoad) return undefined

    const controller = new AbortController()
    setLoading(true)
    setError(null)
    setServices([])
    setSelectedService(null)
    setSelectedConnection(null)
    setSelectedContext(null)
    setTools([])
    setSelectedToolIds([])
    setResourcePath([])

    loadFlowToolServices({ organizationId, workspaceId, flowId, signal: controller.signal })
      .then((payload) => {
        setServices(Array.isArray(payload.services) ? payload.services : [])
      })
      .catch((loadError) => {
        if (loadError.name === "AbortError") return
        setError(loadError)
      })
      .finally(() => {
        if (!controller.signal.aborted) setLoading(false)
      })

    return () => controller.abort()
  }

  useEffect(loadServices, [open, organizationId, workspaceId, flowId])

  useEffect(() => {
    if (!open || !selectedContext) return undefined

    const controller = new AbortController()
    setToolsLoading(true)
    setToolsError(null)
    setTools([])
    setSelectedToolIds([])
    setResourcePath([])

    loadFlowProviderTools({
      organizationId,
      workspaceId,
      flowId,
      connectionId: selectedContext.connection.id,
      providerType: selectedContext.provider.provider_type,
      signal: controller.signal
    })
      .then((payload) => {
        setTools(Array.isArray(payload.tools) ? payload.tools : [])
      })
      .catch((loadError) => {
        if (loadError.name === "AbortError") return
        setToolsError(loadError)
      })
      .finally(() => {
        if (!controller.signal.aborted) setToolsLoading(false)
      })

    return () => controller.abort()
  }, [flowId, open, organizationId, selectedContext, workspaceId])

  const selectedResourceSelection = useMemo(
    () => sharedResourceSelection(tools, selectedToolIds),
    [tools, selectedToolIds]
  )
  const selectedResourceKeys = new Set(resourcePath.map((resource) => resource.stepKey))
  const missingRequiredSelection = selectedResourceSelection.steps.some((step) => step.required !== false && !selectedResourceKeys.has(step.key))
  const canAddSelectedTools = selectedToolIds.length > 0 && selectedResourceSelection.compatible && !missingRequiredSelection
  const loadResourceOptions = useCallback(({ stepKey, selectedResources, query, cursor, signal }) => {
    if (!selectedContext) return Promise.resolve({ items: [] })

    return loadFlowProviderResourceOptions({
      organizationId,
      workspaceId,
      flowId,
      connectionId: selectedContext.connection.id,
      providerType: selectedContext.provider.provider_type,
      toolIds: selectedToolIds,
      stepKey,
      selectedResources,
      query: query?.trim(),
      cursor,
      signal
    }).then((payload) => {
      const page = payload.resources || {}
      return {
        items: Array.isArray(page.items) ? page.items : [],
        nextCursor: page.nextCursor,
        searchable: page.searchable,
        display: page.display || {},
        metadata: page.metadata || {}
      }
    })
  }, [flowId, organizationId, selectedContext, selectedToolIds, workspaceId])

  const serviceCount = services.length
  const chooseService = (entry) => {
    const connections = Array.isArray(entry.connections) ? entry.connections : []
    const connection = connections[0]
    const providers = Array.isArray(connection?.providers) ? connection.providers : []

    if (connections.length === 1 && providers.length === 1) {
      setSelectedContext({ service: entry.service || {}, connection, provider: providers[0] })
      return
    }

    setSelectedService(entry)
    setSelectedConnection(null)
  }
  const chooseConnection = (connection) => {
    const providers = Array.isArray(connection?.providers) ? connection.providers : []

    if (providers.length === 1) {
      setSelectedContext({ service: selectedService.service || {}, connection, provider: providers[0] })
      return
    }

    setSelectedConnection(connection)
  }
  const chooseProvider = (provider) => {
    if (!selectedService || !selectedConnection) return
    setSelectedContext({ service: selectedService.service || {}, connection: selectedConnection, provider })
  }
  const goBackFromToolStep = () => {
    setSelectedContext(null)

    if (!selectedService) return
    if (selectedConnection) return

    setSelectedService(null)
  }
  const toggleTool = (toolId) => {
    setSelectedToolIds((current) =>
      current.includes(toolId)
        ? current.filter((id) => id !== toolId)
        : [...current, toolId]
    )
    setResourcePath([])
  }
  const addSelectedTools = () => {
    if (!selectedContext || selectedToolIds.length === 0) return
    if (!canAddSelectedTools) return

    const sortedToolIds = [...selectedToolIds].sort()
    const toolLabelSnapshots = Object.fromEntries(
      tools
        .filter((tool) => sortedToolIds.includes(tool.id))
        .map((tool) => [tool.id, tool.label || titleizeToolId(tool.id)])
    )
    const existingToolLinks = definition?.toolLinks || []
    const nextLink = {
      id: nextNodeToolLinkId(node.id, existingToolLinks),
      providerType: selectedContext.provider.provider_type,
      serviceKey: selectedContext.service.key,
      connectionId: selectedContext.connection.id,
      connectionLabelSnapshot: selectedContext.connection.label,
      serviceNameSnapshot: selectedContext.service.name || selectedContext.service.key,
      toolLabelSnapshots,
      enabled: true,
      tools: sortedToolIds,
      resourcePath,
      metadata: {}
    }
    const link = nextLink
    const toolLinks = [...existingToolLinks, link]
    const existingGrants = node.data.toolGrants || []
    const nextGrant = { toolLinkId: link.id, tools: sortedToolIds }
    const toolGrants = [...existingGrants, nextGrant]

    updateDefinition({ toolLinks })
    updateNodeData(node.id, { toolGrants })
    onOpenChange(false)
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-2xl">
        <DialogHeader>
          <DialogTitle>{t("flowEditor.tools.modal.title")}</DialogTitle>
          <DialogDescription>{t("flowEditor.tools.modal.description")}</DialogDescription>
        </DialogHeader>

        <div className="min-h-72">
          {!selectedService && !selectedContext && loading && (
            <div role="status" aria-label={t("flowEditor.tools.modal.loading")} className="space-y-3">
              {[0, 1, 2].map((item) => (
                <div key={item} className="rounded-md border border-border/70 p-3">
                  <Skeleton className="h-4 w-40" />
                  <Skeleton className="mt-3 h-3 w-64" />
                </div>
              ))}
            </div>
          )}

          {!selectedService && !selectedContext && !loading && error && (
            <div className="flex min-h-64 flex-col items-center justify-center rounded-md border border-dashed border-border p-6 text-center">
              <XCircle className="h-8 w-8 text-rose-500" />
              <h3 className="mt-3 text-sm font-semibold text-foreground">{t("flowEditor.tools.modal.errorTitle")}</h3>
              <p className="mt-1 max-w-sm text-sm leading-6 text-muted-foreground">{t("flowEditor.tools.modal.errorDescription")}</p>
              <Button variant="secondary" type="button" className="mt-4" onClick={loadServices}>
                <RefreshCw className="h-4 w-4" />
                {t("flowEditor.tools.modal.retry")}
              </Button>
            </div>
          )}

          {!selectedService && !selectedContext && !loading && !error && serviceCount === 0 && (
            <div className="flex min-h-64 flex-col items-center justify-center rounded-md border border-dashed border-border p-6 text-center">
              <KeyRound className="h-8 w-8 text-muted-foreground" />
              <h3 className="mt-3 text-sm font-semibold text-foreground">{t("flowEditor.tools.modal.emptyTitle")}</h3>
              <p className="mt-1 max-w-sm text-sm leading-6 text-muted-foreground">{t("flowEditor.tools.modal.emptyDescription")}</p>
            </div>
          )}

          {!selectedService && !selectedContext && !loading && !error && serviceCount > 0 && (
            <div className="space-y-2" aria-label={t("flowEditor.tools.modal.servicesLabel")}>
              {services.map((entry) => (
                <ServiceChoice key={entry.service?.key || entry.service_key} entry={entry} t={t} onChoose={chooseService} />
              ))}
            </div>
          )}

          {selectedService && !selectedConnection && !selectedContext && (
            <div className="space-y-4">
              <StepHeader
                title={t("flowEditor.tools.modal.chooseConnection")}
                description={selectedService.service?.name || selectedService.service?.key}
                onBack={() => setSelectedService(null)}
                backLabel={t("flowEditor.tools.modal.back")}
              />
              <div className="space-y-2">
                {(selectedService.connections || []).map((connection) => (
                  <button
                    key={connection.id}
                    type="button"
                    className="flex w-full items-start justify-between gap-4 rounded-md border border-border/70 bg-background p-3 text-left transition hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    onClick={() => chooseConnection(connection)}
                  >
                    <span className="min-w-0">
                      <span className="block truncate text-sm font-semibold text-foreground">{connection.label}</span>
                      <span className="mt-1 block text-xs text-muted-foreground">
                        {countItems(connection.providers) === 1
                          ? t("flowEditor.tools.modal.providerCount.one")
                          : t("flowEditor.tools.modal.providerCount.many", { count: countItems(connection.providers) })}
                      </span>
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}

          {selectedService && selectedConnection && !selectedContext && (
            <div className="space-y-4">
              <StepHeader
                title={t("flowEditor.tools.modal.chooseProvider")}
                description={selectedConnection.label}
                onBack={() => setSelectedConnection(null)}
                backLabel={t("flowEditor.tools.modal.back")}
              />
              <div className="space-y-2">
                {(selectedConnection.providers || []).map((provider) => (
                  <button
                    key={provider.provider_type}
                    type="button"
                    className="flex w-full items-start justify-between gap-4 rounded-md border border-border/70 bg-background p-3 text-left transition hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    onClick={() => chooseProvider(provider)}
                  >
                    <span className="min-w-0">
                      <span className="block truncate text-sm font-semibold text-foreground">{provider.provider_type}</span>
                      <span className="mt-1 block text-xs text-muted-foreground">{(provider.capabilities || []).join(", ")}</span>
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}

          {selectedContext && (
            <div className="space-y-4">
              <div className="flex items-start gap-3">
                <Button variant="ghost" size="icon" type="button" className="h-8 w-8 shrink-0" onClick={goBackFromToolStep} aria-label={t("flowEditor.tools.modal.back")}>
                  <ArrowLeft className="h-4 w-4" />
                </Button>
                <div className="min-w-0">
                  <h3 className="truncate text-base font-semibold text-foreground">{selectedContext.service.name || selectedContext.service.key}</h3>
                  <p className="mt-1 text-sm text-muted-foreground">
                    {t("flowEditor.tools.modal.toolStepDescription", { connection: selectedContext.connection.label })}
                  </p>
                </div>
              </div>

              {toolsLoading && (
                <div role="status" aria-label={t("flowEditor.tools.modal.loadingTools")} className="space-y-3">
                  {[0, 1, 2].map((item) => (
                    <div key={item} className="rounded-md border border-border/70 p-3">
                      <Skeleton className="h-4 w-44" />
                      <Skeleton className="mt-3 h-3 w-72" />
                    </div>
                  ))}
                </div>
              )}

              {!toolsLoading && toolsError && (
                <div className="flex min-h-48 flex-col items-center justify-center rounded-md border border-dashed border-border p-6 text-center">
                  <XCircle className="h-8 w-8 text-rose-500" />
                  <h3 className="mt-3 text-sm font-semibold text-foreground">{t("flowEditor.tools.modal.toolsErrorTitle")}</h3>
                  <p className="mt-1 max-w-sm text-sm leading-6 text-muted-foreground">{t("flowEditor.tools.modal.toolsErrorDescription")}</p>
                </div>
              )}

              {!toolsLoading && !toolsError && tools.length === 0 && (
                <div className="flex min-h-48 flex-col items-center justify-center rounded-md border border-dashed border-border p-6 text-center">
                  <KeyRound className="h-8 w-8 text-muted-foreground" />
                  <h3 className="mt-3 text-sm font-semibold text-foreground">{t("flowEditor.tools.modal.noToolsTitle")}</h3>
                  <p className="mt-1 max-w-sm text-sm leading-6 text-muted-foreground">{t("flowEditor.tools.modal.noToolsDescription")}</p>
                </div>
              )}

              {!toolsLoading && !toolsError && tools.length > 0 && (
                <div className="space-y-2">
                  {tools.map((tool) => (
                    <label key={tool.id} className="flex cursor-pointer items-start gap-3 rounded-md border border-border/70 p-3 transition hover:bg-muted/50">
                      <input
                        type="checkbox"
                        className="mt-1 h-4 w-4 rounded border-border"
                        checked={selectedToolIds.includes(tool.id)}
                        onChange={() => toggleTool(tool.id)}
                        aria-label={tool.label || tool.id}
                      />
                      <span className="min-w-0">
                        <span className="block text-sm font-semibold text-foreground">{tool.label || tool.id}</span>
                        {tool.description && (
                          <span className="mt-1 block text-sm leading-6 text-muted-foreground">{tool.description}</span>
                        )}
                      </span>
                    </label>
                  ))}
                </div>
              )}

              {!selectedResourceSelection.compatible && (
                <div className="rounded-md border border-dashed border-border p-4 text-sm text-muted-foreground">
                  {t("flowEditor.tools.modal.incompatibleResourceFlows")}
                </div>
              )}

              {selectedResourceSelection.compatible && selectedResourceSelection.steps.length > 0 && (
                <ResourceSelectionFlow
                  steps={selectedResourceSelection.steps}
                  selectedResources={resourcePath}
                  onChange={setResourcePath}
                  loadOptions={loadResourceOptions}
                  t={t}
                />
              )}

              <DialogFooter>
                <Button variant="secondary" type="button" onClick={() => onOpenChange(false)}>
                  {t("flowEditor.tools.modal.cancel")}
                </Button>
                <Button type="button" onClick={addSelectedTools} disabled={!canAddSelectedTools}>
                  {t("flowEditor.tools.modal.done")}
                </Button>
              </DialogFooter>
            </div>
          )}
        </div>
      </DialogContent>
    </Dialog>
  )
}

function ServiceChoice({ entry, t, onChoose }) {
  const service = entry.service || {}
  const connections = Array.isArray(entry.connections) ? entry.connections : []
  const providerCount = connections.reduce((count, connection) => count + countItems(connection.providers), 0)
  const connectionLabel = connections.length === 1
    ? connections[0].label
    : t("flowEditor.tools.modal.connectionCount", { count: connections.length })
  const providerLabel = providerCount === 1
    ? t("flowEditor.tools.modal.providerCount.one")
    : t("flowEditor.tools.modal.providerCount.many", { count: providerCount })

  return (
    <button
      type="button"
      className="flex w-full items-start justify-between gap-4 rounded-md border border-border/70 bg-background p-3 text-left transition hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      onClick={() => onChoose(entry)}
    >
      <span className="min-w-0">
        <span className="block truncate text-sm font-semibold text-foreground">{service.name || service.key}</span>
        <span className="mt-1 block truncate text-xs text-muted-foreground">{connectionLabel}</span>
      </span>
      <span className="shrink-0 rounded-md bg-muted px-2 py-1 text-xs font-medium text-muted-foreground">
        {providerLabel}
      </span>
    </button>
  )
}

function StepHeader({ title, description, onBack, backLabel }) {
  return (
    <div className="flex items-start gap-3">
      <Button variant="ghost" size="icon" type="button" className="h-8 w-8 shrink-0" onClick={onBack} aria-label={backLabel}>
        <ArrowLeft className="h-4 w-4" />
      </Button>
      <div className="min-w-0">
        <h3 className="truncate text-base font-semibold text-foreground">{title}</h3>
        {description && <p className="mt-1 text-sm text-muted-foreground">{description}</p>}
      </div>
    </div>
  )
}
