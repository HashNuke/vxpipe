import React from "react"
import { Handshake, Trash2 } from "lucide-react"

import { Input } from "@/components/ui/input"
import { cn as cx } from "@/lib/utils"

import { useTranslation } from "../../i18n"
import { normalizeLocalPhoneNumber } from "./flow-definition"
import { InspectorRow } from "./inspector-primitives"

const sidebarControlClass = "border-border/70 bg-muted/30 shadow-none focus-visible:ring-1"

export function HumanInspector({ node, updateNodeData, onDeleteNode, canDeleteNode, phoneCountryCode }) {
  const { t } = useTranslation()
  const data = node.data
  const handoff = data.handoff || {}

  const updateHandoff = (updates) => {
    updateNodeData(node.id, { handoff: { ...handoff, ...updates } })
  }

  return (
    <aside className="flex h-full min-h-0 w-full flex-col overflow-hidden bg-background">
      <div className="p-4 pb-2">
        <div className="flex items-center justify-between gap-3 text-xs font-medium uppercase tracking-wide text-muted-foreground">
          <div className="flex items-center gap-2">
            <Handshake className="h-3.5 w-3.5" />
            <span>{t("flowEditor.human.nameLabel")}</span>
          </div>
          <div className="flex items-center gap-2">
            {canDeleteNode && (
              <button
                type="button"
                className="inline-flex h-7 w-7 items-center justify-center rounded-md text-slate-400 transition hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950"
                aria-label={t("flowEditor.actions.deleteNode")}
                onClick={() => onDeleteNode(node.id)}
              >
                <Trash2 className="h-4 w-4" />
              </button>
            )}
          </div>
        </div>
        <Input
          className={cx("mt-2", sidebarControlClass)}
          value={data.label}
          onChange={(event) => updateNodeData(node.id, { label: event.target.value, name: event.target.value })}
          aria-label={t("flowEditor.human.nameLabel")}
        />
      </div>

      <div className="min-h-0 flex-1 overflow-auto p-4">
        <div className="space-y-5">
          <label className="block space-y-2">
            <span className="text-sm font-medium text-foreground">{t("flowEditor.human.phoneLabel")}</span>
            <div className="flex rounded-md border border-input bg-background shadow-xs focus-within:ring-2 focus-within:ring-ring">
              <input
                className="w-20 shrink-0 border-r border-input bg-muted px-3 text-sm font-medium text-muted-foreground outline-none"
                value={phoneCountryCode}
                disabled
                aria-label={t("flowEditor.human.countryCodeLabel")}
              />
              <input
                className="min-w-0 flex-1 bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted-foreground"
                value={handoff.phoneNumber || ""}
                onChange={(event) => updateHandoff({ phoneNumber: normalizeLocalPhoneNumber(event.target.value) })}
                inputMode="tel"
                autoComplete="tel-national"
                aria-label={t("flowEditor.human.localPhoneLabel")}
                placeholder={t("flowEditor.human.phonePlaceholder")}
              />
            </div>
            <span className="block text-xs text-muted-foreground">{t("flowEditor.human.phoneHelp")}</span>
          </label>

          <div className="rounded-md border border-border bg-muted/30 p-3">
            <div className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
              {t("flowEditor.human.timing")}
            </div>
            <dl className="mt-3 space-y-2 text-sm">
              <InspectorRow label="Availability check" value={handoff.availabilityTimeout || "5 seconds"} />
              <InspectorRow label="Ring duration" value={handoff.ringDuration || "20 seconds"} />
              <InspectorRow label="Max attempt" value={handoff.totalAttemptDuration || "30 seconds"} />
              <InspectorRow label="Retry" value={handoff.retryCount || "0"} />
              <InspectorRow label="Fallback" value={handoff.unavailableFallback || "None"} />
            </dl>
          </div>
        </div>
      </div>
    </aside>
  )
}
