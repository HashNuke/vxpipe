import React, { useEffect, useMemo, useState } from "react"
import { AlertTriangle, CircleAlert, FileText, Lock, MessageSquareText, Plus, Search, Trash2 } from "lucide-react"

import { Input } from "@/components/ui/input"
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "@/components/ui/item"
import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover"
import { Switch } from "@/components/ui/switch"
import { cn as cx } from "@/lib/utils"

import { useTranslation } from "../../i18n"
import { Button } from "../../ui"
import { countItems } from "./display-helpers"
import { knowledgeIcon, knowledgeOptions } from "./knowledge"
import { LexicalPromptEditor } from "./prompt-editor"
import { VariableRetentionControl } from "./variable-retention-control"

const flowTabLabels = [
  { id: "system", labelKey: "flowEditor.tabs.system" },
  { id: "variables", labelKey: "flowEditor.tabs.variables" },
  { id: "channels", labelKey: "flowEditor.tabs.channels" },
  { id: "tools", labelKey: "flowEditor.tabs.tools" },
  { id: "knowledge", labelKey: "flowEditor.tabs.knowledge" }
]

const variableTypes = ["text", "number", "boolean", "date", "time", "phone", "email", "enum"]

function FieldLabel({ children }) {
  return <label className="text-xs font-medium uppercase tracking-wide text-muted-foreground">{children}</label>
}

function chatChannelRows(channels) {
  const entries = Object.entries(channels || {})
  const rows = entries.length > 0 ? entries : [["testchat", { enabled: true, locked: true }]]

  return rows
    .map(([id, config]) => ({
      id,
      enabled: config?.enabled === true,
      locked: config?.locked === true
    }))
    .sort((a, b) => a.id.localeCompare(b.id))
}

function channelLabel(channelId, t) {
  switch (channelId) {
    case "testchat":
      return t("flowEditor.channels.testchat")
    case "whatsapp":
      return t("flowEditor.channels.whatsapp")
    default:
      return channelId
  }
}

function channelDescription(channelId, t) {
  switch (channelId) {
    case "testchat":
      return t("flowEditor.channels.testchatDescription")
    case "whatsapp":
      return t("flowEditor.channels.whatsappDescription")
    default:
      return channelId
  }
}

function whatsappPhoneLabel(phoneNumber, t) {
  const displayNumber = phoneNumber?.display_phone_number || phoneNumber?.phone_e164 || phoneNumber?.phone_number_id
  const verifiedName = phoneNumber?.verified_name

  if (displayNumber && verifiedName) return `${displayNumber} · ${verifiedName}`
  return displayNumber || verifiedName || t("flowEditor.channels.unnamedWhatsAppPhone")
}

function starterValidationErrors(fieldErrors) {
  return (fieldErrors || []).filter((error) => {
    const path = error?.path || []
    return path[0] === "chat_agent" && ["starterList", "starters"].includes(path[1])
  })
}

function starterFieldLabel(error, t) {
  const path = error?.path || []

  if (path[1] === "starterList") {
    const locale = path[3]
    const field = path[4]

    switch (field) {
      case "title":
        return t("flowEditor.starters.fields.listTitle", { locale })
      case "button_label":
        return t("flowEditor.starters.fields.listButtonLabel", { locale })
      default:
        return t("flowEditor.starters.fields.listCopy", { locale })
    }
  }

  if (path[1] === "starters") {
    const starter = path[2]
    const locale = path[4]
    const field = path[5]

    switch (field) {
      case "row_title":
        return t("flowEditor.starters.fields.rowTitle", { starter, locale })
      case "row_description":
        return t("flowEditor.starters.fields.rowDescription", { starter, locale })
      case "fallback_text":
        return t("flowEditor.starters.fields.fallbackText", { starter, locale })
      default:
        return t("flowEditor.starters.fields.starterCopy", { starter, locale })
    }
  }

  return t("flowEditor.starters.fields.copy")
}

function starterFieldPath(error) {
  return (error?.path || []).join(".")
}

function StarterValidationPanel({ errors, t }) {
  if (errors.length === 0) return null

  return (
    <div
      role="alert"
      data-testid="whatsapp-starter-validation-errors"
      className="mt-3 rounded-md border border-destructive/30 bg-destructive/5 px-3 py-3 text-sm text-destructive"
    >
      <div className="flex items-center gap-2 font-medium text-destructive">
        <AlertTriangle className="h-4 w-4" aria-hidden="true" />
        <span>{t("flowEditor.starters.validationTitle")}</span>
      </div>
      <p className="mt-1 text-xs leading-5 text-destructive/90">
        {t("flowEditor.starters.validationDescription")}
      </p>
      <ul className="mt-2 space-y-1.5">
        {errors.map((error, index) => (
          <li
            key={`${error.message_key}-${starterFieldPath(error)}-${index}`}
            data-field-path={starterFieldPath(error)}
            className="rounded-md bg-background/70 px-2 py-1.5 leading-5"
          >
            <span className="block text-xs font-medium text-destructive">
              {starterFieldLabel(error, t)}
            </span>
            <span>{t(error.message_key, error.values || {})}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

function underscorizeVariableName(value) {
  return (value || "variable")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "")
    || "variable"
}

function uniqueVariableKey(existingVariables, label) {
  const baseKey = underscorizeVariableName(label)
  let key = baseKey
  let index = 2

  while (existingVariables.some((variable) => variable.key === key)) {
    key = `${baseKey}_${index}`
    index += 1
  }

  return key
}

function nextVariableLabel(existingVariables, t) {
  let index = existingVariables.length + 1
  let label = t("flowEditor.variables.newVariable", { index })

  while (existingVariables.some((variable) => variable.label === label)) {
    index += 1
    label = t("flowEditor.variables.newVariable", { index })
  }

  return label
}

export function FlowLevelInspector({
  definition,
  flow,
  isChatFlow = false,
  availableWhatsappPhoneNumbers = [],
  bindingWhatsappPhoneNumber = false,
  whatsappEntrypoint = null,
  validationFieldErrors = [],
  onBindWhatsappPhoneNumber,
  updateChatAgent,
  updateDefinition,
  updateFlowSettings
}) {
  const [activeTab, setActiveTab] = useState("system")
  const [knowledgeOpen, setKnowledgeOpen] = useState(false)
  const [knowledgeQuery, setKnowledgeQuery] = useState("")
  const { t } = useTranslation()
  const flowSettings = definition?.flowSettings || {}
  const chatAgent = definition?.chat_agent || {}
  const chatVariables = chatAgent.variables || []
  const channels = definition?.channels || {}
  const tools = flowSettings.tools || []
  const knowledge = flowSettings.knowledge || { grants: [] }
  const channelRows = useMemo(() => chatChannelRows(channels), [channels])
  const starterErrors = useMemo(() => starterValidationErrors(validationFieldErrors), [validationFieldErrors])
  const enabledChannelCount = channelRows.filter((channel) => channel.enabled).length
  const selectedWhatsappPhoneNumberId = whatsappEntrypoint?.whatsapp_phone_number_id
    ? String(whatsappEntrypoint.whatsapp_phone_number_id)
    : ""
  const visibleTabs = useMemo(
    () => flowTabLabels.filter((tab) => isChatFlow || !["channels", "variables"].includes(tab.id)),
    [isChatFlow]
  )
  const filteredKnowledgeOptions = knowledgeOptions.filter((option) => {
    const query = knowledgeQuery.trim().toLowerCase()
    if (!query) return true
    return `${option.label} ${option.description}`.toLowerCase().includes(query)
  })

  const updateKnowledge = (nextKnowledge) => updateFlowSettings({ knowledge: nextKnowledge })
  const promptValue = isChatFlow ? chatAgent.instructions || "" : flowSettings.systemPrompt || ""
  const updatePrompt = (instructions) => {
    if (isChatFlow) {
      updateChatAgent?.({ instructions })
    } else {
      updateFlowSettings({ systemPrompt: instructions })
    }
  }
  const updateChatVariables = (variables) => updateChatAgent?.({ variables })
  const updateChatVariable = (variableKey, updates) => {
    updateChatVariables(chatVariables.map((variable) => variable.key === variableKey ? { ...variable, ...updates } : variable))
  }
  const updateChatVariableLabel = (variableKey, label) => {
    updateChatVariables(chatVariables.map((variable) => {
      if (variable.key !== variableKey) return variable
      const otherVariables = chatVariables.filter((candidate) => candidate.key !== variableKey)
      return { ...variable, label, key: uniqueVariableKey(otherVariables, label) }
    }))
  }
  const addChatVariable = () => {
    const label = nextVariableLabel(chatVariables, t)
    updateChatVariables([
      ...chatVariables,
      {
        key: uniqueVariableKey(chatVariables, label),
        label,
        type: "text",
        required: false
      }
    ])
  }
  const removeChatVariable = (variableKey) => {
    updateChatVariables(chatVariables.filter((variable) => variable.key !== variableKey))
  }
  const addKnowledgeGrant = (option) => {
    const grants = knowledge.grants || []
    if (grants.some((grant) => grant.id === option.id)) return
    updateKnowledge({ ...knowledge, grants: [...grants, option] })
    setKnowledgeOpen(false)
    setKnowledgeQuery("")
  }
  const removeKnowledgeGrant = (grantId) => {
    updateKnowledge({
      ...knowledge,
      grants: (knowledge.grants || []).filter((grant) => grant.id !== grantId)
    })
  }
  const updateChannel = (channelId, updates) => {
    updateDefinition?.({
      channels: {
        ...channels,
        [channelId]: {
          ...(channels[channelId] || {}),
          ...updates
        }
      }
    })
  }
  const bindWhatsappPhoneNumber = (event) => {
    const value = event.target.value
    if (!value) return
    onBindWhatsappPhoneNumber?.(value)
  }

  useEffect(() => {
    if (!visibleTabs.some((tab) => tab.id === activeTab)) {
      setActiveTab(visibleTabs[0]?.id || "system")
    }
  }, [activeTab, visibleTabs])

  useEffect(() => {
    if (starterErrors.length > 0 && visibleTabs.some((tab) => tab.id === "channels")) {
      setActiveTab("channels")
    }
  }, [starterErrors.length, visibleTabs])

  return (
    <aside className="flex h-full min-h-0 w-full flex-col overflow-hidden bg-background">
      <div className="p-4 pb-2">
        <div className="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">
          <FileText className="h-3.5 w-3.5" />
          <span>{t("flowEditor.flowProperties")}</span>
        </div>
        <div className="mt-4 rounded-md border border-border/70 bg-muted/30 px-3 py-2">
          <div className="text-xs font-medium uppercase tracking-wide text-muted-foreground">{t("flowEditor.workspace")}</div>
          <div className="mt-1 truncate text-sm font-medium text-foreground">{flow?.workspace || t("flowEditor.workspace")}</div>
        </div>
        <StarterValidationPanel errors={starterErrors} t={t} />
      </div>

      <div className="flex min-h-0 flex-1 flex-col">
        <div className="overflow-x-auto border-b border-slate-200 px-4">
          <div role="tablist" aria-label={t("flowEditor.settingsTabs")} className="flex h-auto justify-start gap-1 rounded-none bg-transparent p-0 text-slate-500">
            {visibleTabs.map((tab) => (
              <button
                key={tab.id}
                type="button"
                role="tab"
                aria-selected={activeTab === tab.id}
                className={cx(
                  "rounded-none border-b-2 bg-transparent px-3 py-3 text-sm font-medium shadow-none transition hover:text-slate-950",
                  activeTab === tab.id
                    ? "border-slate-950 text-slate-950"
                    : "border-transparent text-slate-500"
                )}
                onClick={() => setActiveTab(tab.id)}
              >
                {t(tab.labelKey)}
              </button>
            ))}
          </div>
        </div>

        {activeTab === "system" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-hidden p-4">
          <div className="flex h-full min-h-0 flex-col">
            <FieldLabel>{isChatFlow ? t("flowEditor.chatAgent.instructions") : t("flowEditor.systemPrompt")}</FieldLabel>
            <div className="mt-2 min-h-0 flex-1">
              {isChatFlow ? (
                <textarea
                  value={promptValue}
                  onChange={(event) => updatePrompt(event.target.value)}
                  aria-label={t("flowEditor.chatAgent.instructions")}
                  className="h-full min-h-72 w-full resize-none rounded-md border border-border/70 bg-muted/30 px-3 py-3 text-sm text-foreground outline-none transition focus:ring-1 focus:ring-ring"
                  placeholder={t("flowEditor.chatAgent.instructionsPlaceholder")}
                />
              ) : (
                <LexicalPromptEditor
                  key="flow-system-prompt"
                  editorKey="flow"
                  value={promptValue}
                  onChange={updatePrompt}
                  className="h-full min-h-0"
                />
              )}
            </div>
          </div>
        </div>
        )}

        {activeTab === "variables" && isChatFlow && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <div className="flex items-center justify-between gap-3">
              <FieldLabel>{t("flowEditor.variables.chatCollected")}</FieldLabel>
              <Button variant="secondary" size="sm" type="button" onClick={addChatVariable}>
                <Plus className="h-4 w-4" />
                {t("flowEditor.variables.add")}
              </Button>
            </div>

            <div className="space-y-2">
              {chatVariables.map((variable) => (
                <div key={variable.key} className="rounded-md border border-border/70 bg-card p-3">
                  <div className="grid gap-2 sm:grid-cols-[minmax(0,1fr)_8rem]">
                    <div className="min-w-0">
                      <Input
                        className="border-border/70 bg-muted/30 shadow-none focus-visible:ring-1"
                        value={variable.label}
                        onChange={(event) => updateChatVariableLabel(variable.key, event.target.value)}
                        aria-label={t("flowEditor.variables.labelAria", { key: variable.key })}
                      />
                    </div>
                    <select
                      value={variable.type || "text"}
                      onChange={(event) => updateChatVariable(variable.key, { type: event.target.value })}
                      className="h-9 rounded-md border border-border/70 bg-muted/30 px-2 text-sm shadow-none outline-none transition-colors focus:ring-1 focus:ring-ring"
                      aria-label={t("flowEditor.variables.typeAria", { label: variable.label })}
                    >
                      {variableTypes.map((type) => <option key={type} value={type}>{type}</option>)}
                    </select>
                  </div>
                  <div className="mt-2 flex flex-wrap items-center gap-2">
                    <button
                      type="button"
                      className={cx(
                        "flex h-9 w-9 items-center justify-center rounded-md border transition",
                        variable.required
                          ? "border-amber-300 bg-amber-50 text-amber-700"
                          : "border-border bg-background text-muted-foreground hover:bg-muted hover:text-foreground"
                      )}
                      aria-pressed={variable.required || false}
                      aria-label={t("flowEditor.variables.requiredAria", { label: variable.label })}
                      title={t("flowEditor.variables.requiredTitle")}
                      onClick={() => updateChatVariable(variable.key, { required: !variable.required })}
                    >
                      <CircleAlert className="h-4 w-4" />
                    </button>
                    <VariableRetentionControl
                      variable={variable}
                      t={t}
                      onChange={(updates) => updateChatVariable(variable.key, updates)}
                    />
                    <button
                      type="button"
                      className="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-foreground"
                      aria-label={t("flowEditor.variables.removeAria", { label: variable.label })}
                      onClick={() => removeChatVariable(variable.key)}
                    >
                      <Trash2 className="h-4 w-4" />
                    </button>
                  </div>
                </div>
              ))}
              {chatVariables.length === 0 && (
                <div className="rounded-md border border-dashed border-border p-6 text-center text-sm text-muted-foreground">
                  {t("flowEditor.variables.chatEmpty")}
                </div>
              )}
            </div>
          </div>
        </div>
        )}

        {activeTab === "tools" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <div>
              <FieldLabel>{t("flowEditor.flowTools")}</FieldLabel>
              <ItemGroup className="mt-2 rounded-md border border-border/60">
                {tools.map((tool) => (
                  <React.Fragment key={tool}>
                    <Item asChild size="sm">
                      <label>
                        <ItemMedia>
                          <Switch checked onCheckedChange={() => {}} aria-label={`${tool} enabled`} />
                        </ItemMedia>
                        <ItemContent>
                          <ItemTitle>{tool}</ItemTitle>
                        </ItemContent>
                      </label>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                ))}
                {tools.length === 0 && (
                  <Item size="sm">
                    <ItemContent>
                      <ItemDescription>{t("flowEditor.flowToolsEmpty")}</ItemDescription>
                    </ItemContent>
                  </Item>
                )}
              </ItemGroup>
            </div>
          </div>
        </div>
        )}

        {activeTab === "channels" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <div>
              <FieldLabel>{t("flowEditor.channels.title")}</FieldLabel>
              <ItemGroup className="mt-2 rounded-md border border-border/60">
                {channelRows.map((channel, index) => {
                  const finalEnabledChannel = channel.enabled && enabledChannelCount <= 1
                  const disabled = channel.locked || finalEnabledChannel
                  const label = channelLabel(channel.id, t)
                  const requiredLabel = t("flowEditor.channels.required", { channel: label })

                  return (
                    <React.Fragment key={channel.id}>
                      <Item size="sm">
                        <ItemMedia variant="icon">
                          <MessageSquareText />
                        </ItemMedia>
                        <ItemContent>
                          <ItemTitle>{label}</ItemTitle>
                          <ItemDescription>{channelDescription(channel.id, t)}</ItemDescription>
                          {channel.id === "whatsapp" && channel.enabled && (
                            <div className="mt-3 space-y-2">
                              <select
                                value={selectedWhatsappPhoneNumberId}
                                onChange={bindWhatsappPhoneNumber}
                                disabled={bindingWhatsappPhoneNumber || availableWhatsappPhoneNumbers.length === 0}
                                aria-label={t("flowEditor.channels.whatsappPhoneLabel")}
                                className="h-9 w-full max-w-md rounded-md border border-input bg-background px-3 text-sm text-foreground outline-none transition focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-60"
                              >
                                <option value="">{t("flowEditor.channels.whatsappPhonePlaceholder")}</option>
                                {availableWhatsappPhoneNumbers.map((phoneNumber) => (
                                  <option key={phoneNumber.id} value={String(phoneNumber.id)}>
                                    {whatsappPhoneLabel(phoneNumber, t)}
                                  </option>
                                ))}
                              </select>
                              {availableWhatsappPhoneNumbers.length === 0 && (
                                <ItemDescription>{t("flowEditor.channels.whatsappPhoneEmpty")}</ItemDescription>
                              )}
                            </div>
                          )}
                        </ItemContent>
                        <ItemActions className="items-center gap-2">
                          {disabled && <Lock className="h-3.5 w-3.5 text-muted-foreground" aria-hidden="true" />}
                          <Switch
                            checked={channel.enabled}
                            disabled={disabled}
                            onCheckedChange={(enabled) => updateChannel(channel.id, { enabled })}
                            aria-label={disabled ? requiredLabel : t("flowEditor.channels.toggle", { channel: label })}
                          />
                        </ItemActions>
                      </Item>
                      {index < channelRows.length - 1 && <ItemSeparator />}
                    </React.Fragment>
                  )
                })}
              </ItemGroup>
            </div>
          </div>
        </div>
        )}

        {activeTab === "knowledge" && (
        <div role="tabpanel" className="m-0 min-h-0 flex-1 overflow-auto p-4">
          <div className="space-y-4">
            <Popover open={knowledgeOpen} onOpenChange={setKnowledgeOpen}>
              <PopoverTrigger asChild>
                <Button variant="secondary" type="button" className="w-full">
                  <Plus className="h-4 w-4" />
                  {t("flowEditor.knowledge.addFiles")}
                </Button>
              </PopoverTrigger>
              <PopoverContent align="start" className="w-[24rem] p-2">
                <div className="flex items-center gap-2 rounded-md border border-input px-2">
                  <Search className="h-4 w-4 text-muted-foreground" />
                  <input
                    value={knowledgeQuery}
                    onChange={(event) => setKnowledgeQuery(event.target.value)}
                    placeholder={t("flowEditor.knowledge.searchPlaceholder")}
                    className="h-9 min-w-0 flex-1 bg-transparent text-sm outline-none"
                  />
                </div>
                <div className="mt-2 max-h-56 overflow-auto">
                  {filteredKnowledgeOptions.map((option) => {
                    const OptionIcon = knowledgeIcon(option.type)
                    return (
                      <button
                        key={option.id}
                        type="button"
                        className="flex w-full items-start gap-3 rounded-md px-2 py-2 text-left text-sm hover:bg-muted"
                        onClick={() => addKnowledgeGrant(option)}
                      >
                        <OptionIcon className="mt-0.5 h-4 w-4 text-muted-foreground" />
                        <span>
                          <span className="block font-medium text-foreground">{option.label}</span>
                          <span className="text-xs text-muted-foreground">{option.description}</span>
                        </span>
                      </button>
                    )
                  })}
                </div>
              </PopoverContent>
            </Popover>

            <ItemGroup className="rounded-md border border-border/60">
              {(knowledge.grants || []).map((grant) => {
                const GrantIcon = knowledgeIcon(grant.type)
                return (
                  <React.Fragment key={grant.id}>
                    <Item size="sm">
                      <ItemMedia variant="icon">
                        <GrantIcon />
                      </ItemMedia>
                      <ItemContent>
                        <ItemTitle>{grant.label}</ItemTitle>
                        <ItemDescription>{grant.description}</ItemDescription>
                      </ItemContent>
                      <ItemActions>
                        <button type="button" className="text-xs font-medium text-muted-foreground hover:text-foreground" onClick={() => removeKnowledgeGrant(grant.id)}>
                          {t("flowEditor.knowledge.remove")}
                        </button>
                      </ItemActions>
                    </Item>
                    <ItemSeparator />
                  </React.Fragment>
                )
              })}
              {countItems(knowledge.grants) === 0 && (
                <div className="px-4 py-6 text-center">
                  <div className="mx-auto flex h-9 w-9 items-center justify-center rounded-md bg-muted text-muted-foreground">
                    <FileText className="h-4 w-4" />
                  </div>
                  <div className="mt-3 text-sm font-medium text-foreground">{t("flowEditor.knowledge.empty")}</div>
                </div>
              )}
            </ItemGroup>
          </div>
        </div>
        )}
      </div>
    </aside>
  )
}
