import React from "react"
import { Bot, Handshake, Workflow } from "lucide-react"

import { Button } from "../../ui"

export function FlowEditorToolbar({ t, onAddNode, onArrangeNodes }) {
  return (
    <div
      data-flow-editor-toolbar
      role="toolbar"
      aria-label={t("flowEditor.toolbar.addNodes")}
      aria-orientation="horizontal"
      className="absolute bottom-4 left-1/2 z-10 flex w-max max-w-[calc(100vw-1rem)] -translate-x-1/2 flex-nowrap items-center justify-start gap-1.5 overflow-x-auto rounded-md border border-slate-300 bg-slate-950 p-2 shadow-lg shadow-slate-900/20 lg:right-[calc(34rem+0.75rem)] lg:left-[calc((100%-34rem)/2)] lg:max-w-[calc(100vw-35rem)]"
    >
      <div role="group" aria-label={t("flowEditor.toolbar.addNodes")} className="flex shrink-0 items-center gap-1 rounded-sm bg-white/10 p-1">
        <span className="px-1.5 text-xs font-medium text-white/80">{t("flowEditor.toolbar.add")}</span>
        <Button variant="secondary" size="sm" className="h-8 justify-center border-white/15 bg-white text-slate-950 hover:bg-slate-100 px-3" onClick={() => onAddNode("agent")} aria-label={t("flowEditor.actions.addAgent")}>
          <Bot className="h-4 w-4" />
          {t("flowEditor.actions.addAgent")}
        </Button>
        <Button variant="secondary" size="sm" className="h-8 justify-center border-white/15 bg-white text-slate-950 hover:bg-slate-100 px-3" onClick={() => onAddNode("human")} aria-label={t("flowEditor.actions.addHumanHandoff")}>
          <Handshake className="h-4 w-4" />
          {t("flowEditor.actions.addHumanHandoff")}
        </Button>
      </div>
      <Button variant="secondary" size="sm" className="h-8 justify-center border-white/15 bg-white text-slate-950 hover:bg-slate-100 px-3" onClick={onArrangeNodes} aria-label={t("flowEditor.actions.arrangeNodes")}>
        <Workflow className="h-4 w-4" />
        {t("flowEditor.actions.arrangeNodes")}
      </Button>
    </div>
  )
}
