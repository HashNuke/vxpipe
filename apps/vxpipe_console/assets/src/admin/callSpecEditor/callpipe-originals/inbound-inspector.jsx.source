import React, { useState } from "react"
import { Check, ChevronDown, PhoneIncoming, Search } from "lucide-react"

import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover"
import { Switch } from "@/components/ui/switch"

import { Button } from "../../ui"
import {
  DEFAULT_RECORDING_DISCLOSURE_MESSAGE,
  poolSearchText,
  selectedNumberPool
} from "./flow-definition"
import { pluralize } from "./display-helpers"
import { InspectorShell } from "./inspector-primitives"

export function InboundInspector({ node, updateNodeData, availableNumberPools }) {
  const data = node.data
  const [open, setOpen] = useState(false)
  const [query, setQuery] = useState("")
  const selectedPool = selectedNumberPool(data, availableNumberPools)
  const filteredPools = availableNumberPools.filter((pool) => {
    const normalizedQuery = query.trim().toLowerCase()
    if (!normalizedQuery) return true
    return poolSearchText(pool).includes(normalizedQuery)
  })

  const choosePool = (pool) => {
    updateNodeData(node.id, {
      numberPoolId: pool.id,
      numberPoolName: pool.name,
      numberPoolSize: pool.numbers
    })
    setOpen(false)
    setQuery("")
  }

  return (
    <InspectorShell title="Inbound" icon={PhoneIncoming}>
      <div className="space-y-5 text-sm">
        <label className="block space-y-2">
          <span className="text-sm font-medium text-foreground">Inbound number</span>
          <Popover open={open} onOpenChange={setOpen}>
            <PopoverTrigger asChild>
              <Button
                type="button"
                variant="secondary"
                className="w-full justify-between"
                aria-label="Inbound number"
              >
                <span className="min-w-0 truncate text-left">
                  {selectedPool?.name || "Select an inbound number"}
                </span>
                <ChevronDown className="h-4 w-4 shrink-0 text-muted-foreground" />
              </Button>
            </PopoverTrigger>
            <PopoverContent align="start" className="w-[24rem] p-2">
              <div className="flex items-center gap-2 rounded-md border border-input px-2">
                <Search className="h-4 w-4 text-muted-foreground" />
                <input
                  value={query}
                  onChange={(event) => setQuery(event.target.value)}
                  placeholder="Search inbound numbers"
                  className="h-9 min-w-0 flex-1 bg-transparent text-sm outline-none"
                  aria-label="Search inbound numbers"
                />
              </div>
              <div className="mt-2 max-h-60 overflow-auto">
                {filteredPools.map((pool) => (
                  <button
                    key={pool.id}
                    type="button"
                    className="flex w-full items-start justify-between gap-3 rounded-md px-2 py-2 text-left text-sm hover:bg-muted"
                    onClick={() => choosePool(pool)}
                  >
                    <span className="min-w-0">
                      <span className="block truncate font-medium text-foreground">{pool.name}</span>
                      <span className="block truncate text-xs text-muted-foreground">
                        {pool.workspace} · {pluralize(pool.numbers || 0, "number")}
                      </span>
                    </span>
                    {String(selectedPool?.id) === String(pool.id) && <Check className="mt-0.5 h-4 w-4 shrink-0 text-slate-950" />}
                  </button>
                ))}
                {filteredPools.length === 0 && (
                  <div className="px-3 py-6 text-center text-sm text-muted-foreground">
                    No unused inbound numbers match that search.
                  </div>
                )}
              </div>
            </PopoverContent>
          </Popover>
          <span className="block text-xs text-muted-foreground">
            Only inbound numbers not used by another flow are available here.
          </span>
        </label>

        <section
          className="rounded-md border border-border/70 bg-muted/30 p-3"
          aria-labelledby="inbound-recording-disclosure-title"
          data-inbound-recording-disclosure
        >
          <div className="flex items-center justify-between gap-3">
            <label className="flex min-w-0 flex-1 items-center gap-3">
              <Switch
                checked
                disabled
                aria-label="Call recording disclosure"
              />
              <span id="inbound-recording-disclosure-title" className="text-sm font-medium text-foreground">
                Call recording disclosure
              </span>
            </label>
          </div>

          <label className="mt-3 flex flex-col gap-2.5 border-t border-border/70 pt-3">
            <span className="text-xs font-medium uppercase tracking-wide text-muted-foreground">Call recording disclosure message</span>
            <textarea
              className="min-h-20 w-full resize-none rounded-md border border-border/70 bg-background px-3 py-2 text-sm text-foreground shadow-none outline-none focus-visible:ring-1 focus-visible:ring-ring"
              value={DEFAULT_RECORDING_DISCLOSURE_MESSAGE}
              readOnly
              aria-label="Call recording disclosure message"
            />
          </label>
        </section>
      </div>
    </InspectorShell>
  )
}
