export const TestCallModal = {
  render: () => <TestCallModalStory />,
  play: async () => {
    const body = within(document.body)
    await expect(body.findByRole("dialog", { name: "Test call" })).resolves.toBeInTheDocument()
    await expect(body.findByRole("heading", { name: "Test setup" })).resolves.toBeInTheDocument()
    await expect(body.findByRole("textbox", { name: "AI caller prompt" })).resolves.toHaveValue("Ask about same-day availability.")
  }
}

export const TestCallModalStarted = {
  render: () => <TestCallModalStory started />,
  parameters: {
    msw: {
      handlers: []
    }
  },
  play: async () => {
    const body = within(document.body)
    const dialog = await body.findByRole("dialog", { name: "Test call" })
    await userEvent.click(within(dialog).getByRole("radio", { name: "Let AI speak" }))
    await expect(within(dialog).findByRole("button", { name: "Start test" })).resolves.toBeEnabled()
  }
}
