export const Toolbar = {
  render: () => (
    <StoryProviders className="relative h-28 w-[48rem] overflow-hidden rounded-md border border-border bg-slate-100">
      <FlowEditorToolbar t={t} onAddNode={() => {}} onArrangeNodes={() => {}} onOpenTestCall={() => {}} />
    </StoryProviders>
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await expect(canvas.findByRole("toolbar", { name: "Add flow nodes" })).resolves.toBeInTheDocument()
    await expect(canvas.findByRole("button", { name: "AI agent" })).resolves.toBeInTheDocument()
  }
}

export const NodeCards = {
  render: () => (
    <StoryProviders className="grid grid-cols-1 gap-4 rounded-md border border-border bg-background p-5 lg:grid-cols-3">
      <NodeCard node={inboundNode} />
      <NodeCard node={agentNode} selected />
      <NodeCard node={humanNode} />
    </StoryProviders>
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await expect(canvas.findByText("Inbound")).resolves.toBeInTheDocument()
    await expect(canvas.findByText("Roof intake agent")).resolves.toBeInTheDocument()
    await expect(canvas.findByText("On-call roof specialist")).resolves.toBeInTheDocument()
  }
}

export const InspectorPrimitives = {
  render: () => (
    <InspectorFrame>
      <InspectorShell title="Selected edge" subtitle="Workflow transition">
        <dl className="space-y-3 text-sm">
          <InspectorRow label="Trigger" value="transfer" />
          <InspectorRow label="Source" value="intake" />
          <InspectorRow label="Target" value="human-handoff" />
        </dl>
      </InspectorShell>
    </InspectorFrame>
  )
}

export const VariableRetentionDefault = {
  render: () => (
    <VariableRetentionControlStory
      initialVariable={{ key: "reason_for_call", label: "Reason for call", type: "text", required: true }}
    />
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await userEvent.click(await canvas.findByRole("button", { name: "Configure sensitive retention for Reason for call" }))
    await expect(within(document.body).findByRole("dialog", { name: "Sensitive variable retention" })).resolves.toBeInTheDocument()
  }
}

export const VariableRetentionSensitiveActive = {
  render: () => (
    <VariableRetentionControlStory
      initialVariable={{ key: "patient_dob", label: "Patient date of birth", type: "date", required: true, sensitive: true, retention_hours: 7 * 24 }}
    />
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await expect(canvas.findByRole("button", { name: "Configure sensitive retention for Patient date of birth, currently 7d" })).resolves.toBeInTheDocument()
  }
}

export const VariableRetentionUnsensitive = {
  render: () => (
    <VariableRetentionControlStory
      initialVariable={{ key: "patient_phone", label: "Patient phone", type: "phone", required: true, sensitive: true, retention_hours: 30 * 24 }}
    />
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await userEvent.click(await canvas.findByRole("button", { name: "Configure sensitive retention for Patient phone, currently 30d" }))
    await userEvent.click(await within(document.body).findByRole("button", { name: "Unsensitive" }))
    await expect(canvas.findByRole("button", { name: "Configure sensitive retention for Patient phone" })).resolves.toBeInTheDocument()
  }
}

export const VariableRetentionValidation = {
  render: () => (
    <VariableRetentionControlStory
      initialVariable={{ key: "policy_number", label: "Policy number", type: "text", required: false }}
    />
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await userEvent.click(await canvas.findByRole("button", { name: "Configure sensitive retention for Policy number" }))
    const dialog = within(document.body)
    await userEvent.type(await dialog.findByLabelText("Custom days"), "366")
    await userEvent.click(await dialog.findByRole("button", { name: "Save retention" }))
    await expect(dialog.findByText("Enter a retention from 0.5 to 365 days.")).resolves.toBeInTheDocument()
  }
}

export const VariableRetentionNarrowViewport = {
  render: () => (
    <VariableRetentionControlStory
      initialVariable={{ key: "patient_dob", label: "Patient date of birth", type: "date", required: true, sensitive: true, retention_hours: 36 }}
    />
  ),
  parameters: {
    viewport: {
      defaultViewport: "mobile1"
    }
  }
}

