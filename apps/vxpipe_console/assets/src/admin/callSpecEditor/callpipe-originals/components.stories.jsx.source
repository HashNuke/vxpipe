import React, { useState } from "react"
import { ReactFlowProvider } from "@xyflow/react"
import { expect, userEvent, within } from "storybook/test"

import enMessages from "../../../../../priv/static/assets/i18n/workspace/en.json"
import { serverFlowEditorResponse } from "../../../../tests/fixtures.js"
import { I18nProvider } from "../../i18n.jsx"
import { FlowEditorHeader, FlowNameDialog } from "./editor-header.jsx"
import { FlowEditorToolbar } from "./editor-toolbar.jsx"
import { FlowNode } from "./flow-node.jsx"
import { AgentInspector } from "./agent-inspector.jsx"
import { HumanInspector } from "./human-inspector.jsx"
import { InboundInspector } from "./inbound-inspector.jsx"
import { SelectedEdgeInspector } from "./selected-edge-inspector.jsx"
import { InspectorRow, InspectorShell } from "./inspector-primitives.jsx"
import { FlowTestCallModal } from "./test-call-modal.jsx"
import { VariableRetentionControl } from "./variable-retention-control.jsx"

globalThis.__callpipeLocaleMessages = {
  ...(globalThis.__callpipeLocaleMessages || {}),
  en: enMessages
}

const t = (key, values = {}) => {
  const message = enMessages[key] || key
  return Object.entries(values).reduce(
    (current, [name, value]) => current.replaceAll(`{${name}}`, String(value)),
    message
  )
}

const flow = serverFlowEditorResponse.flow
const definition = serverFlowEditorResponse.definition
const nodes = definition.nodes
const inboundNode = nodes.find((node) => node.id === "inbound-call")
const agentNode = nodes.find((node) => node.id === "intake")
const humanNode = nodes.find((node) => node.id === "human-handoff")
const transferEdge = { id: "intake-handoff", source: "intake", target: "human-handoff", label: "transfer", data: { kind: "transfer" } }

function StoryProviders({ children, className = "min-h-[28rem] bg-background" }) {
  return (
    <I18nProvider locale="en" localeSource="storybook">
      <div className={className}>{children}</div>
    </I18nProvider>
  )
}

function InspectorFrame({ children }) {
  return (
    <StoryProviders className="h-[42rem] w-[34rem] overflow-hidden rounded-md border border-border bg-background">
      {children}
    </StoryProviders>
  )
}

function NodeCard({ node, selected = false }) {
  return (
    <ReactFlowProvider>
      <div className="relative flex h-56 w-[24rem] items-center justify-center rounded-md border border-border bg-slate-100">
        <FlowNode data={node.data} selected={selected} />
      </div>
    </ReactFlowProvider>
  )
}

function AgentInspectorStory() {
  const [node, setNode] = useState(agentNode)
  const [currentDefinition, setDefinition] = useState(definition)

  return (
    <AgentInspector
      organizationId="1"
      workspaceId="11"
      flowId="21"
      definition={currentDefinition}
      node={node}
      allNodes={nodes}
      updateDefinition={(updates) => setDefinition((current) => ({ ...current, ...updates }))}
      updateNodeData={(_nodeId, updates) => setNode((current) => ({ ...current, data: { ...current.data, ...updates } }))}
      onDeleteNode={() => {}}
      canDeleteNode
      onAddTransferDestination={() => {}}
      onRemoveTransferDestination={() => {}}
    />
  )
}

function VariableRetentionControlStory({ initialVariable }) {
  const [variable, setVariable] = useState(initialVariable)

  return (
    <StoryProviders className="flex min-h-[18rem] items-start justify-center bg-background p-8">
      <div className="flex w-80 items-center justify-between rounded-md border border-border/70 bg-card p-3">
        <div>
          <div className="text-sm font-medium text-foreground">{variable.label}</div>
          <div className="text-xs text-muted-foreground">{variable.key} · {variable.type}</div>
        </div>
        <VariableRetentionControl
          variable={variable}
          t={t}
          onChange={(updates) => setVariable((current) => ({ ...current, ...updates }))}
        />
      </div>
    </StoryProviders>
  )
}

function HumanInspectorStory() {
  const [node, setNode] = useState(humanNode)

  return (
    <HumanInspector
      node={node}
      updateNodeData={(_nodeId, updates) => setNode((current) => ({ ...current, data: { ...current.data, ...updates } }))}
      onDeleteNode={() => {}}
      canDeleteNode
      phoneCountryCode="+1"
    />
  )
}

function InboundInspectorStory() {
  const [node, setNode] = useState(inboundNode)

  return (
    <InboundInspector
      node={node}
      updateNodeData={(_nodeId, updates) => setNode((current) => ({ ...current, data: { ...current.data, ...updates } }))}
      availableNumberPools={serverFlowEditorResponse.available_number_pools}
    />
  )
}

function TestCallModalStory({ started = false }) {
  const [open, setOpen] = useState(true)
  const [prompt, setPrompt] = useState("Ask about same-day availability.")

  return (
    <StoryProviders className="min-h-[44rem] bg-slate-100">
      <button type="button" className="sr-only" onClick={() => setOpen(true)}>Open</button>
      <FlowTestCallModal
        open={open}
        onClose={() => setOpen(false)}
        organizationId="1"
        workspaceId="11"
        flowId="21"
        aiCallerPrompt={prompt}
        onAiCallerPromptChange={setPrompt}
        t={t}
      />
      {started && <span className="sr-only">Start the call from the play function</span>}
    </StoryProviders>
  )
}

const meta = {
  title: "Workspace/Flows/Components/Flow Editor",
  parameters: {
    layout: "centered"
  }
}

export default meta

export const Header = {
  render: () => (
    <StoryProviders className="relative h-24 w-[58rem] overflow-hidden rounded-md border border-border bg-slate-100">
      <FlowEditorHeader
        backHref="/o/1/w/11/flows"
        flowName="New Patient Appointment Intake"
        saving={false}
        loading={false}
        onEditFlowName={() => {}}
        onSaveDraft={() => {}}
      />
    </StoryProviders>
  ),
  play: async ({ canvasElement }) => {
    const canvas = within(canvasElement)
    await expect(canvas.findByRole("button", { name: "Edit flow name" })).resolves.toBeInTheDocument()
    await expect(canvas.findByRole("button", { name: "Save draft" })).resolves.toBeEnabled()
  }
}

export const HeaderSaving = {
  render: () => (
    <StoryProviders className="relative h-24 w-[58rem] overflow-hidden rounded-md border border-border bg-slate-100">
