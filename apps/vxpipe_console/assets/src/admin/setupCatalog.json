{
  "version": 1,
  "providers": [
    {
      "id": "deepgram",
      "name": "Deepgram",
      "description": "Listen and speak with one service.",
      "capabilities": ["stt", "tts"],
      "defaultModels": {
        "stt": "flux-general-multi",
        "tts": "flux-hannah-en"
      },
      "sampleCapabilities": ["stt", "tts"]
    },
    {
      "id": "rime",
      "name": "Rime",
      "description": "Store and test Rime credentials. Call audio is not supported yet.",
      "capabilities": [],
      "defaultModels": {},
      "sampleCapabilities": []
    },
    {
      "id": "google",
      "name": "Google AI Studio",
      "description": "Connect Gemini language models.",
      "capabilities": ["llm"],
      "defaultModels": {
        "llm": "gemini-2.5-flash"
      },
      "sampleCapabilities": ["llm"]
    },
    {
      "id": "zenmux",
      "name": "Zenmux",
      "description": "Connect a language model through Zenmux.",
      "capabilities": ["llm"],
      "defaultModels": {
        "llm": "openai/gpt-5"
      },
      "sampleCapabilities": ["llm"]
    },
    {
      "id": "telnyx",
      "name": "Telnyx",
      "description": "Connect phone calls with Telnyx.",
      "capabilities": ["telephony"],
      "defaultModels": {},
      "sampleCapabilities": []
