{
  "version": 1,
  "providers": [
    {
      "id": "deepgram",
      "name": "Deepgram",
      "description": "Listen and speak with one service.",
      "capabilities": ["stt", "tts"],
      "defaultModels": {
        "stt": "flux-general-multi",
        "tts": "flux-hannah-en"
      },
      "sampleCapabilities": ["stt", "tts"]
    },
    {
      "id": "rime",
      "name": "Rime",
      "description": "Speak with Rime Coda.",
      "capabilities": ["tts"],
      "defaultModels": {
        "tts": "coda"
      },
      "sampleCapabilities": ["tts"]
    },
    {
      "id": "google",
      "name": "Google AI Studio",
      "description": "Connect Gemini language, transcription, and speech synthesis.",
      "capabilities": ["stt", "llm", "tts"],
      "defaultModels": {
        "stt": "gemini-3.5-transcribe-live",
        "llm": "gemini-2.5-flash",
        "tts": "gemini-3.1-flash-tts-preview"
      },
      "sampleCapabilities": ["stt", "llm", "tts"]
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "description": "Connect GPT language models and live speech with one API key.",
      "capabilities": ["llm", "s2s"],
      "defaultModels": {
        "llm": "gpt-5",
        "s2s": "gpt-live-1"
      },
      "sampleCapabilities": ["llm", "s2s"]
    },
    {
      "id": "zenmux",
      "name": "Zenmux",
      "description": "Connect a language model through Zenmux.",
      "capabilities": ["llm"],
      "defaultModels": {
        "llm": "openai/gpt-5"
      },
      "sampleCapabilities": ["llm"]
    },
    {
      "id": "telnyx",
      "name": "Telnyx",
      "description": "Connect phone calls with Telnyx.",
      "capabilities": ["telephony"],
      "defaultModels": {},
      "sampleCapabilities": []
    },
    {
      "id": "twilio",
      "name": "Twilio",
      "description": "Connect phone calls with Twilio.",
      "capabilities": ["telephony"],
      "defaultModels": {},
      "sampleCapabilities": []
    }
  ]
}
