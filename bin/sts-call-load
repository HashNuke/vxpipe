#!/usr/bin/env bash
set -euo pipefail

# Explicit measured mode is for a coordinated quiet window only.
profile="${1:-smoke}"
case "$profile" in
  smoke|measured) ;;
  *) echo 'Usage: bin/sts-call-load [smoke|measured]' >&2; exit 2 ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cpu_count="$(getconf _NPROCESSORS_ONLN)"
schedulers=$((cpu_count / 2))
if (( schedulers < 1 )); then schedulers=1; fi
if (( schedulers > 2 )); then schedulers=2; fi
export ERL_FLAGS="+S ${schedulers}:${schedulers} +SDcpu 1 +SDio 1 +A 2"
export VXPIPE_CALL_LOAD_PROFILE="$profile"
cd "$repo_root/apps/vxpipe_call_engine"
timeout --signal=TERM --kill-after=10s 360s mix test \
  test/vxpipe/call_engine/speech/call_load_test.exs \
  --include integration --seed 0 --max-cases 1
