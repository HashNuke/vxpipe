#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

exec watchman-make \
  -p 'apps/*/lib/**/*.ex' \
  'apps/*/lib/**/*.exs' \
  'apps/*/src/**/*.erl' \
  'apps/*/include/**/*.hrl' \
  'apps/*/mix.exs' \
  'config/*.exs' \
  'mix.exs' \
  'mix.lock' \
  --run bin/restart-vxpipe
