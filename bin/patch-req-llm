#!/usr/bin/env python3
"""Apply the reviewed ReqLLM patch only to its exact pinned Hex source."""
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def apply_patch(root):
    dependency = root / "deps/req_llm"
    patch = root / "patches/req_llm/google-native-signatures.patch"
    manifest = json.loads(patch.with_suffix(".json").read_text())
    version = re.search(r'"req_llm": \{:hex, :req_llm, "([^"]+)"', (root / "mix.lock").read_text())
    if not version or version.group(1) != manifest["hex_version"] or digest(patch) != manifest["patch_sha256"]:
        raise ValueError("ReqLLM version or patch checksum differs from the reviewed manifest")
    actual = {name: digest(dependency / name) for name in manifest["files"]}
    upgrades = ([manifest["previous"]] if manifest.get("previous") else []) + manifest.get("older", [])
    for previous in upgrades:
        if digest(patch.parent / previous["patch_file"]) != previous["patch_sha256"]:
            raise ValueError("ReqLLM upgrade patch checksum differs from the reviewed manifest")
    if all(actual[name] == hashes["patched"] for name, hashes in manifest["files"].items()):
        print("ReqLLM native signature patch verified")
        return
    if not all(actual[name] == hashes["original"] for name, hashes in manifest["files"].items()):
        previous = next((candidate for candidate in upgrades if actual == candidate["files"]), None)
        if previous:
            patch = patch.parent / previous["patch_file"]
        else:
            raise ValueError("ReqLLM sources differ from reviewed states; preserve changes and review the patch")
    command = ["patch", "--batch", "--forward", "-p1", "-i", str(patch)]
    subprocess.run(command + ["--dry-run"], cwd=dependency, check=True)
    subprocess.run(command, cwd=dependency, check=True)
    if not all(digest(dependency / name) == hashes["patched"] for name, hashes in manifest["files"].items()):
        raise ValueError("ReqLLM patch result failed checksum verification")
    print("ReqLLM native signature patch applied and verified")


if __name__ == "__main__":
    try:
        apply_patch(Path(__file__).resolve().parent.parent)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"ReqLLM patch preparation failed: {error}", file=sys.stderr)
        sys.exit(1)
