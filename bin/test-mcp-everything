#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fixture_root="$(mktemp -d -t vxpipe-mcp-everything.XXXXXXXX)"
expected_commit="a40bc270fb5ece62673f8a1196f57116d885c5eb"
server_pid=""
server_log="$fixture_root/server.log"

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill -INT "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi

  rm -rf -- "$fixture_root"
}

trap cleanup EXIT

git -c advice.detachedHead=false clone --quiet --depth 1 --branch 2026.8.31 \
  https://github.com/modelcontextprotocol/servers.git "$fixture_root/source"

actual_commit="$(git -C "$fixture_root/source" rev-parse HEAD)"
if [[ "$actual_commit" != "$expected_commit" ]]; then
  echo "unexpected MCP Everything source revision" >&2
  exit 1
fi

npm --prefix "$fixture_root/source" ci --ignore-scripts --no-audit --no-fund
npm --prefix "$fixture_root/source" run build --workspace @modelcontextprotocol/server-everything

port="$(elixir -e '{:ok, socket} = :gen_tcp.listen(0, [:binary, active: false]); {:ok, {_address, port}} = :inet.sockname(socket); IO.puts(port); :gen_tcp.close(socket)')"

PORT="$port" node "$fixture_root/source/src/everything/dist/index.js" streamableHttp \
  >"$server_log" 2>&1 &
server_pid="$!"

ready=false
for _attempt in {1..100}; do
  if curl --silent --output /dev/null --max-time 1 "http://127.0.0.1:$port/mcp"; then
    ready=true
    break
  fi

  if ! kill -0 "$server_pid" 2>/dev/null; then
    break
  fi

  sleep 0.1
done

if [[ "$ready" != true ]]; then
  echo "MCP Everything fixture did not become ready" >&2
  sed -n '1,160p' "$server_log" >&2
  exit 1
fi

"$project_root/bin/mcp-reference-client" "http://127.0.0.1:$port/mcp"
