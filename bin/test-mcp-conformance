#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
client_command="$project_root/bin/mcp-conformance-client"

cd "$project_root"

npx -y @modelcontextprotocol/conformance@0.1.16 client \
  --command "$client_command" \
  --scenario initialize \
  --spec-version 2025-11-25 \
  --timeout 30000

npx -y @modelcontextprotocol/conformance@0.1.16 client \
  --command "$client_command" \
  --scenario tools_call \
  --spec-version 2025-11-25 \
  --timeout 30000
