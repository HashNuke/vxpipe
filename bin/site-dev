#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="http"

case "${1:-}" in
  "") ;;
  --tailscale) mode="tailscale"; shift ;;
  *) echo "Usage: bin/site-dev [--tailscale]" >&2; exit 1 ;;
esac

if [[ $# -gt 0 ]]; then
  echo "Usage: bin/site-dev [--tailscale]" >&2
  exit 1
fi

export VXPIPE_DEV_TLS="http"
export ASTRO_DEV_BACKGROUND="0"
cd "$repo_root"

if [[ "$mode" == "tailscale" ]]; then
  exec "$repo_root/bin/with-tailscale" npm --prefix vxpipe-docs run dev
fi

exec npm --prefix vxpipe-docs run dev
