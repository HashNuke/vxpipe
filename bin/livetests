#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${VXPIPE_LIVE_PROVIDERS_ENV_FILE:-${HOME}/.config/vxpipe/live_providers.env}"
mix_bin="${VXPIPE_LIVE_PROVIDERS_MIX_BIN:-mix}"
state_root="${VXPIPE_LIVETESTS_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/vxpipe/livetests}"
tailscale_bin="${VXPIPE_LIVETESTS_TAILSCALE_BIN:-tailscale}"
tailscaled_bin="${VXPIPE_LIVETESTS_TAILSCALED_BIN:-$(command -v tailscaled || echo /usr/sbin/tailscaled)}"
test_port="${TELEPHONY_TEST_PORT:-4600}"
test_tag="tag:vxp-test"

usage() {
  cat <<'USAGE'
Usage: bin/livetests <command> [arguments]

Commands:
  run [mix test arguments]  Run live provider tests. Without arguments, run
                            every live_providers test in the integration lanes.
                            Telephony selections start this machine's public
                            test endpoint and stop it afterwards.
  tools:up                  Start this machine's vxp-test-<machine> Tailscale
                            node and its Funnel; leave them running.
  tools:down                Remove the Funnel mapping and stop the node.
  tools:status              Show the node, public URL and Funnel target.
  telephony:provision [--allow-purchase]
                            Find or create this machine's Telnyx application,
                            outbound profile and number, and Twilio number,
                            and point them at this machine. Buys numbers only
                            with --allow-purchase. Safe to re-run.
  telephony:status          Show this machine's carrier resources (read-only).
  help                      Show this help.

Credentials are read from ~/.config/vxpipe/live_providers.env (override with
VXPIPE_LIVE_PROVIDERS_ENV_FILE) and passed only to the child mix test process.
See config/live_providers.env.example and docs/live-telephony-harness.md.
USAGE
}

die() {
  printf 'livetests: %s\n' "$*" >&2
  exit 1
}

# Progress reports use fd 3 so callers can silence them without hiding errors.
exec 3>&2

# The file is loaded only in this child process. Ignore ambient credentials
# that may have been loaded by an interactive dotenv hook.
credential_names=(
  OPENAI_API_KEY GEMINI_API_KEY ZENMUX_API_KEY DEEPGRAM_API_KEY
  DEEPSEEK_API_KEY OPENROUTER_API_KEY FIREWORKS_API_KEY
  CARTESIA_API_KEY ELEVENLABS_API_KEY
  TELEPHONY_TEST_PUBLIC_URL
  TWILIO_ACCOUNT_SID TWILIO_AUTH_TOKEN TWILIO_TEST_FROM TWILIO_TEST_DESTINATION
  TELNYX_API_KEY TELNYX_PUBLIC_KEY TELNYX_APP_ID TELNYX_TEST_FROM
  TELNYX_TEST_DESTINATION
  TAILSCALE_CLIENT_ID TAILSCALE_CLIENT_SECRET
)

load_credentials() {
  if [[ ! -f "$env_file" ]]; then
    printf 'Missing live provider credentials: %s\n' "$env_file" >&2
    printf 'Copy %s/config/live_providers.env.example to that path and fill in the providers you will run.\n' \
      "$repo_root" >&2
    exit 1
  fi

  unset "${credential_names[@]}"

  set -a
  # shellcheck source=/dev/null
  source "$env_file"
  set +a

  # Template placeholders behave like missing settings at the selected test.
  local name
  for name in "${credential_names[@]}"; do
    case "${!name:-}" in
      ''|todo|http://todo|https://todo) unset "$name" ;;
    esac
  done
}

# --- Per-machine Tailscale test node -------------------------------------

machine_name() {
  local raw name
  raw="${VXP_TEST_MACHINE:-$(hostname -s)}"
  name="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed -E 's/-+/-/g; s/^-+//; s/-+$//')"
  name="${name:0:54}"
  [[ -n "$name" ]] || die "cannot derive a machine name from '$raw'; set VXP_TEST_MACHINE"
  printf '%s' "$name"
}

node_name="vxp-test-$(machine_name)"
node_dir="$state_root/$node_name"
ts_socket="$node_dir/tailscaled.sock"
ts_pidfile="$node_dir/tailscaled.pid"
funnel_target="http://127.0.0.1:$test_port"
lock_held=false

ts() {
  "$tailscale_bin" --socket="$ts_socket" "$@"
}

acquire_lock() {
  [[ "$lock_held" == true ]] && return 0
  mkdir -p "$node_dir"
  chmod 700 "$state_root" "$node_dir" 2>/dev/null || true
  exec 9> "$node_dir/lock"
  flock -n 9 || die "another live test run or tools command is using $node_name; wait for it to finish"
  lock_held=true
}

tailscaled_running() {
  [[ -f "$ts_pidfile" ]] && kill -0 "$(cat "$ts_pidfile")" 2>/dev/null
}

backend_state() {
  ts status --json 2>/dev/null | jq -r '.BackendState // empty'
}

node_dns() {
  ts status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//'
}

current_funnel_target() {
  local dns="$1"
  ts funnel status --json 2>/dev/null |
    jq -r --arg key "$dns:443" '.Web[$key].Handlers["/"].Proxy // empty'
}

start_tailscaled() {
  tailscaled_running && return 0
  mkdir -p "$node_dir/state"
  nohup "$tailscaled_bin" \
    --tun=userspace-networking \
    --statedir="$node_dir/state" \
    --socket="$ts_socket" \
    --port=0 > "$node_dir/tailscaled.log" 2>&1 9>&- &
  printf '%s\n' "$!" > "$ts_pidfile"

  local attempt
  for attempt in $(seq 1 100); do
    [[ -n "$(backend_state)" ]] && return 0
    tailscaled_running || die "tailscaled exited; see $node_dir/tailscaled.log"
    sleep 0.1
  done
  die "tailscaled did not become ready; see $node_dir/tailscaled.log"
}

register_node() {
  local state key_file
  state="$(backend_state)"
  [[ "$state" == Running ]] && return 0

  if [[ "$state" == NeedsLogin ]]; then
    [[ -n "${TAILSCALE_CLIENT_SECRET:-}" ]] ||
      die "$node_name is not registered; set TAILSCALE_CLIENT_SECRET (OAuth client with Auth Keys write and $test_tag) in $env_file"
    key_file="$(mktemp "$node_dir/authkey.XXXXXX")"
    chmod 600 "$key_file"
    printf '%s?ephemeral=false&preauthorized=true' "$TAILSCALE_CLIENT_SECRET" > "$key_file"
    if ! ts up --hostname="$node_name" --advertise-tags="$test_tag" \
      --auth-key="file:$key_file" --timeout=60s; then
      rm -f "$key_file"
      die "registering $node_name failed; check that $test_tag is in tagOwners and the OAuth client has it"
    fi
    rm -f "$key_file"
  else
    ts up --hostname="$node_name" --advertise-tags="$test_tag" --timeout=60s ||
      die "starting $node_name failed; see $node_dir/tailscaled.log"
  fi
}

tools_up() {
  acquire_lock
  start_tailscaled
  register_node

  local dns current
  dns="$(node_dns)"
  [[ "$dns" == "$node_name".* ]] ||
    die "this machine's node registered as '${dns%%.*}', not $node_name. Remove the stale $node_name device in the Tailscale admin console, then run: bin/livetests tools:down && rm -rf '$node_dir' && bin/livetests tools:up"

  current="$(current_funnel_target "$dns")"
  if [[ -z "$current" ]]; then
    ts funnel --bg --https=443 "$funnel_target" > /dev/null ||
      die "starting Funnel failed; check that $test_tag has the funnel node attribute"
  elif [[ "$current" != "$funnel_target" ]]; then
    die "$dns:443 already serves $current; refusing to replace it"
  fi

  public_url="https://$dns"
  printf '%s %s -> %s\n' "$node_name" "$public_url" "$funnel_target"
}

tools_down() {
  acquire_lock
  if tailscaled_running; then
    local dns
    dns="$(node_dns)"
    if [[ -n "$dns" && "$(current_funnel_target "$dns")" == "$funnel_target" ]]; then
      ts funnel --https=443 off > /dev/null 2>&1 || true
    fi
    local pid
    pid="$(cat "$ts_pidfile")"
    kill "$pid" 2>/dev/null || true
    local attempt
    for attempt in $(seq 1 100); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$ts_pidfile"
  printf '%s stopped\n' "$node_name"
}

tools_status() {
  printf 'node:     %s\n' "$node_name"
  printf 'state:    %s\n' "$node_dir"
  if ! tailscaled_running; then
    printf 'running:  no\n'
    return 0
  fi
  local dns
  dns="$(node_dns)"
  printf 'running:  yes (%s)\n' "$(backend_state)"
  printf 'url:      %s\n' "${dns:+https://$dns}"
  printf 'funnel:   %s\n' "$(current_funnel_target "$dns")"
}

tools_running() {
  tailscaled_running || return 1
  local dns
  dns="$(node_dns)"
  [[ -n "$dns" && "$(current_funnel_target "$dns")" == "$funnel_target" ]]
}

# --- Per-machine carrier resources -------------------------------------------

curl_bin="${VXPIPE_LIVETESTS_CURL_BIN:-curl}"
twilio_ingress_key="vxp-test-twilio"

# Credentials go to curl through its stdin config, never through argv.
http_request() {
  local config="$1" method="$2" url="$3"
  shift 3
  local response status body where="${url%%\?*}"
  [[ -n "${TWILIO_ACCOUNT_SID:-}" ]] && where="${where//$TWILIO_ACCOUNT_SID/<account>}"
  response="$(printf '%s\n' "$config" |
    "$curl_bin" -sS -g -K - -X "$method" -w $'\n%{http_code}' "$@" "$url")" ||
    die "$method $where failed"
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$status" != 2* ]]; then
    die "$method $where returned HTTP $status: $(jq -r '[.errors[]?.detail, .message] | map(select(.)) | first // empty' <<< "$body" 2>/dev/null)"
  fi
  printf '%s' "$body"
}

telnyx_api() {
  local method="$1" path="$2" body="${3:-}"
  local arguments=(-H "Content-Type: application/json")
  [[ -n "$body" ]] && arguments+=(--data "$body")
  http_request "header = \"Authorization: Bearer $TELNYX_API_KEY\"" \
    "$method" "https://api.telnyx.com/v2$path" "${arguments[@]}"
}

twilio_api() {
  local method="$1" path="$2"
  shift 2
  local arguments=() field
  for field in "$@"; do arguments+=(--data-urlencode "$field"); done
  http_request "user = \"$TWILIO_ACCOUNT_SID:$TWILIO_AUTH_TOKEN\"" \
    "$method" "https://api.twilio.com/2010-04-01/Accounts/$TWILIO_ACCOUNT_SID$path" "${arguments[@]}"
}

require_carrier_credentials() {
  local name missing=()
  for name in TELNYX_API_KEY TWILIO_ACCOUNT_SID TWILIO_AUTH_TOKEN; do
    [[ -n "${!name:-}" ]] || missing+=("$name")
  done
  [[ ${#missing[@]} -eq 0 ]] || die "set ${missing[*]} in $env_file"
}

carrier_public_url() {
  if [[ -n "${TELEPHONY_TEST_PUBLIC_URL:-}" ]]; then
    printf '%s' "${TELEPHONY_TEST_PUBLIC_URL%/}"
    return 0
  fi
  local suffix
  suffix="$("$tailscale_bin" status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty')"
  [[ -n "$suffix" ]] || die "cannot read this machine's tailnet name; is Tailscale running?"
  printf 'https://%s.%s' "$node_name" "$suffix"
}

# Progress reports go to fd 3 (stderr unless redirected); stdout carries IDs
# between functions. Each ensure_* returns 1 when a resource is missing and 2
# after reporting an error.
report() {
  printf '%-8s %-24s %s\n' "$1" "$2" "$3" >&3
}

carrier_error() {
  printf 'livetests: %s\n' "$*" >&2
  return 2
}

exact_by() {
  jq -c --arg key "$1" --arg value "$2" "first(.data[] | select(.[\$key] == \$value)) // empty"
}

# Each ensure_* function prints the resource ID on stdout and reports on stderr.
ensure_telnyx_profile() {
  local mode="$1" profile
  profile="$(telnyx_api GET "/outbound_voice_profiles?filter[name][contains]=$node_name" | exact_by name "$node_name")" || return 2
  if [[ -n "$profile" ]]; then
    report telnyx "outbound profile" "found $node_name"
  elif [[ "$mode" == check ]]; then
    return 1
  else
    profile="$(telnyx_api POST /outbound_voice_profiles \
      "$(jq -nc --arg n "$node_name" '{name: $n, whitelisted_destinations: ["US"]}')" | jq -c .data)" || return 2
    report telnyx "outbound profile" "created $node_name"
  fi
  jq -r .id <<< "$profile"
}

ensure_telnyx_app() {
  local mode="$1" profile_id="$2" webhook="$3" app wanted
  app="$(telnyx_api GET "/call_control_applications?filter[application_name][contains]=$node_name" |
    exact_by application_name "$node_name")" || return 2
  wanted="$(jq -nc --arg w "$webhook" --arg p "$profile_id" \
    '{webhook_event_url: $w, webhook_api_version: "2", outbound: {outbound_voice_profile_id: $p}}')"
  if [[ -z "$app" ]]; then
    [[ "$mode" == check ]] && return 1
    app="$(telnyx_api POST /call_control_applications \
      "$(jq -c --arg n "$node_name" '. + {application_name: $n}' <<< "$wanted")" | jq -c .data)" || return 2
    report telnyx "voice API application" "created $node_name"
  elif [[ "$(jq -r '.webhook_event_url' <<< "$app")" != "$webhook" ||
    "$(jq -r '.outbound.outbound_voice_profile_id' <<< "$app")" != "$profile_id" ]]; then
    [[ "$mode" == check ]] && { carrier_error "Telnyx application $node_name is not wired to this machine; run bin/livetests telephony:provision"; return 2; }
    app="$(telnyx_api PATCH "/call_control_applications/$(jq -r .id <<< "$app")" "$wanted" | jq -c .data)" || return 2
    report telnyx "voice API application" "updated $node_name"
  else
    report telnyx "voice API application" "found $node_name ($(jq -r .id <<< "$app"))"
  fi
  jq -r .id <<< "$app"
}

ensure_telnyx_number() {
  local mode="$1" purchase="$2" app_id="$3" number candidate attempt
  number="$(telnyx_api GET "/phone_numbers?filter[tag]=$node_name" | jq -c 'first(.data[]) // empty')" || return 2
  if [[ -z "$number" ]]; then
    [[ "$mode" == check ]] && return 1
    [[ "$purchase" == true ]] || {
      report telnyx "number" "missing (re-run with --allow-purchase to buy a US local number)"
      return 1
    }
    candidate="$(telnyx_api GET "/available_phone_numbers?filter[country_code]=US&filter[phone_number_type]=local&filter[features][]=voice&filter[limit]=1" |
      jq -r 'first(.data[].phone_number) // empty')" || return 2
    [[ -n "$candidate" ]] || { carrier_error "Telnyx offered no US local voice number"; return 2; }
    telnyx_api POST /number_orders "$(jq -nc --arg p "$candidate" --arg c "$app_id" --arg r "$node_name" \
      '{phone_numbers: [{phone_number: $p}], connection_id: $c, customer_reference: $r}')" > /dev/null || return 2
    for attempt in $(seq 1 30); do
      number="$(telnyx_api GET "/phone_numbers?filter[phone_number]=${candidate/+/%2B}" | jq -c 'first(.data[]) // empty')" || return 2
      [[ -n "$number" ]] && break
      sleep 2
    done
    [[ -n "$number" ]] || { carrier_error "ordered $candidate from Telnyx but it has not appeared yet; re-run telephony:provision shortly"; return 2; }
    number="$(telnyx_api PATCH "/phone_numbers/$(jq -r .id <<< "$number")" \
      "$(jq -nc --arg t "$node_name" --arg c "$app_id" '{tags: [$t], connection_id: $c}')" | jq -c .data)" || return 2
    report telnyx "number" "bought $(jq -r .phone_number <<< "$number")"
  elif [[ "$(jq -r .connection_id <<< "$number")" != "$app_id" ]]; then
    [[ "$mode" == check ]] && { carrier_error "Telnyx number $(jq -r .phone_number <<< "$number") is not assigned to $node_name; run bin/livetests telephony:provision"; return 2; }
    number="$(telnyx_api PATCH "/phone_numbers/$(jq -r .id <<< "$number")" \
      "$(jq -nc --arg c "$app_id" '{connection_id: $c}')" | jq -c .data)" || return 2
    report telnyx "number" "assigned $(jq -r .phone_number <<< "$number")"
  else
    report telnyx "number" "found $(jq -r .phone_number <<< "$number")"
  fi
  jq -r .phone_number <<< "$number"
}

ensure_twilio_number() {
  local mode="$1" purchase="$2" voice_url="$3" number candidate
  number="$(twilio_api GET "/IncomingPhoneNumbers.json?FriendlyName=$node_name" |
    jq -c --arg n "$node_name" 'first(.incoming_phone_numbers[] | select(.friendly_name == $n)) // empty')" || return 2
  if [[ -z "$number" ]]; then
    [[ "$mode" == check ]] && return 1
    [[ "$purchase" == true ]] || {
      report twilio "number" "missing (re-run with --allow-purchase to buy a US local number)"
      return 1
    }
    candidate="$(twilio_api GET "/AvailablePhoneNumbers/US/Local.json?VoiceEnabled=true&PageSize=1" |
      jq -r 'first(.available_phone_numbers[].phone_number) // empty')" || return 2
    [[ -n "$candidate" ]] || { carrier_error "Twilio offered no US local voice number"; return 2; }
    number="$(twilio_api POST /IncomingPhoneNumbers.json "PhoneNumber=$candidate" \
      "FriendlyName=$node_name" "VoiceUrl=$voice_url" "VoiceMethod=POST")" || return 2
    report twilio "number" "bought $(jq -r .phone_number <<< "$number")"
  elif [[ "$(jq -r .voice_url <<< "$number")" != "$voice_url" || "$(jq -r .voice_method <<< "$number")" != POST ]]; then
    [[ "$mode" == check ]] && { carrier_error "Twilio number $(jq -r .phone_number <<< "$number") is not wired to this machine; run bin/livetests telephony:provision"; return 2; }
    number="$(twilio_api POST "/IncomingPhoneNumbers/$(jq -r .sid <<< "$number").json" \
      "VoiceUrl=$voice_url" "VoiceMethod=POST")" || return 2
    report twilio "number" "updated $(jq -r .phone_number <<< "$number")"
  else
    report twilio "number" "found $(jq -r .phone_number <<< "$number")"
  fi
  jq -r .phone_number <<< "$number"
}

# Runs one ensure_* step, storing its stdout in the named variable. Missing
# resources return 1; an error (already reported) stops the command.
carrier_step() {
  local variable="$1" output status=0
  shift
  output="$("$@")" || status=$?
  [[ "$status" -eq 2 ]] && exit 1
  printf -v "$variable" '%s' "$output"
  return "$status"
}

# mode: provision (create/repair) or check (read-only). Sets carrier_* globals.
carrier_resources() {
  local mode="$1" purchase="${2:-false}" url missing=false profile_id=""
  require_carrier_credentials
  url="$(carrier_public_url)"
  carrier_telnyx_app="" carrier_telnyx_number="" carrier_twilio_number=""

  if carrier_step profile_id ensure_telnyx_profile "$mode" &&
    carrier_step carrier_telnyx_app ensure_telnyx_app "$mode" "$profile_id" "$url/webhooks/platform/telnyx"; then
    carrier_step carrier_telnyx_number ensure_telnyx_number "$mode" "$purchase" "$carrier_telnyx_app" ||
      missing=true
  else
    missing=true
  fi
  carrier_step carrier_twilio_number ensure_twilio_number "$mode" "$purchase" \
    "$url/api/telephony/twilio/$twilio_ingress_key/voice" || missing=true

  [[ "$missing" == false ]]
}

telephony_provision() {
  local purchase=false
  [[ "${1:-}" == --allow-purchase ]] && purchase=true
  load_credentials
  carrier_resources provision "$purchase" ||
    die "some resources are missing; re-run with --allow-purchase to buy them"
  printf 'ready: telnyx %s (app %s), twilio %s\n' \
    "$carrier_telnyx_number" "$carrier_telnyx_app" "$carrier_twilio_number"
}

telephony_status() {
  load_credentials
  carrier_resources check || true
  printf 'telnyx app:    %s\n' "${carrier_telnyx_app:-missing}"
  printf 'telnyx number: %s\n' "${carrier_telnyx_number:-missing}"
  printf 'twilio number: %s\n' "${carrier_twilio_number:-missing}"
}

# Read-only discovery for telephony test runs; each number dials the other.
export_carrier_resources() {
  carrier_resources check 3> /dev/null ||
    die "this machine's carrier resources are missing; run bin/livetests telephony:provision"
  export TELNYX_APP_ID="$carrier_telnyx_app"
  export TELNYX_TEST_FROM="$carrier_telnyx_number" TWILIO_TEST_DESTINATION="$carrier_telnyx_number"
  export TWILIO_TEST_FROM="$carrier_twilio_number" TELNYX_TEST_DESTINATION="$carrier_twilio_number"
}

carrier_credentials_present() {
  [[ -n "${TELNYX_API_KEY:-}" || -n "${TWILIO_ACCOUNT_SID:-}" ]]
}

# --- run --------------------------------------------------------------------

telephony_selected() {
  [[ $# -eq 0 ]] && return 0
  local argument
  for argument in "$@"; do
    case "$argument" in
      live_telephony|live_twilio|live_telnyx|*integration/*telephony*|*twilio*|*telnyx*) return 0 ;;
    esac
  done
  return 1
}

run_tests() {
  load_credentials
  cd -- "$repo_root"

  local mix_arguments=("$@")
  if [[ $# -eq 0 ]]; then
    mix_arguments=(--only live_providers
      apps/vxpipe_agent_runtime/test/integration
      apps/vxpipe_call_engine/test/integration
      apps/vxpipe_gateway/test/integration
      apps/vxpipe_console/test/integration)
  fi

  if ! telephony_selected "$@" || ! carrier_credentials_present; then
    exec "$mix_bin" test "${mix_arguments[@]}"
  fi

  export TELEPHONY_TEST_PORT="$test_port"
  if [[ -n "${TELEPHONY_TEST_PUBLIC_URL:-}" ]]; then
    export_carrier_resources
    exec "$mix_bin" test "${mix_arguments[@]}"
  fi

  acquire_lock
  export_carrier_resources
  if tools_running; then
    public_url="https://$(node_dns)"
  else
    trap 'tools_down > /dev/null' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    tools_up
  fi
  export TELEPHONY_TEST_PUBLIC_URL="$public_url"

  local status=0
  "$mix_bin" test "${mix_arguments[@]}" || status=$?
  exit "$status"
}

command="${1:-}"
[[ $# -gt 0 ]] && shift

case "$command" in
  run) run_tests "$@" ;;
  tools:up)
    load_credentials
    tools_up
    ;;
  tools:down) tools_down ;;
  tools:status) tools_status ;;
  telephony:provision) telephony_provision "$@" ;;
  telephony:status) telephony_status ;;
  help|-h|--help) usage ;;
  '')
    usage >&2
    exit 2
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
