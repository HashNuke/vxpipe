#!/bin/sh

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v forego >/dev/null 2>&1; then
  printf '%s\n' \
    "bin/dev requires forego." \
    "Install it from https://github.com/ddollar/forego and try again."
  exit 127
fi

cd "$project_root"
exec forego start -f Procfile.dev "$@"
