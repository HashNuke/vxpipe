#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="http"

case "${1:-}" in
  "") ;;
  --tailscale) mode="tailscale"; shift ;;
  *) echo "Usage: bin/dev [--tailscale]" >&2; exit 1 ;;
esac

if [[ $# -gt 0 ]]; then
  echo "Usage: bin/dev [--tailscale]" >&2
  exit 1
fi

explicit_port="${PORT:-}"
explicit_host="${APP_HOST:-}"

# Direct Mix commands do not load .env; keep bin/dev's previous behavior.
if [[ -f "$repo_root/.env" ]]; then
  set -a
  source "$repo_root/.env"
  set +a
fi

[[ -z "$explicit_port" ]] || export PORT="$explicit_port"
[[ -z "$explicit_host" ]] || export APP_HOST="$explicit_host"
PORT="$("$repo_root/bin/worktree-port" console --check)"
export PORT
export VXPIPE_DEV_TLS="http"
cd "$repo_root"

if [[ "$mode" == "tailscale" ]]; then
  exec "$repo_root/bin/with-tailscale" mix run --no-halt
fi

exec mix run --no-halt
