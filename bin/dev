#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="http"

case "${1:-}" in
  "") ;;
  --tailscale) mode="tailscale"; shift ;;
  *) echo "Usage: bin/dev [--tailscale]" >&2; exit 1 ;;
esac

if [[ $# -gt 0 ]]; then
  echo "Usage: bin/dev [--tailscale]" >&2
  exit 1
fi

# Direct Mix commands do not load .env; keep bin/dev's previous behavior.
if [[ -f "$repo_root/.env" ]]; then
  set -a
  source "$repo_root/.env"
  set +a
fi

export VXPIPE_DEV_TLS="http"
cd "$repo_root"

if [[ "$mode" == "tailscale" ]]; then
  exec "$repo_root/bin/with-tailscale" mix run --no-halt
fi

exec mix run --no-halt
