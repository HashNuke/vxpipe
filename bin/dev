#!/bin/sh

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v goreman >/dev/null 2>&1; then
  printf '%s\n' \
    "bin/dev requires goreman." \
    "Install it from https://github.com/mattn/goreman and try again."
  exit 127
fi

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' "bin/dev requires Node.js, but it was not found in PATH."
  exit 127
fi

cd "$project_root"
dev_environment=$(node "$project_root/bin/dev-ports.mjs" check "$project_root")

exec goreman -f Procfile.dev -env "$dev_environment" \
  -rpc-server=false -set-ports=false start "$@"
