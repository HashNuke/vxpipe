#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
processes=(vxpipe reloader)
dev_mode="https"
export VXPIPE_CONSOLE_ASSETS_PORT="5173"
export VXPIPE_DEV_TLS="http"
goreman_args=(
  -basedir "$repo_root"
  -f "$repo_root/Procfile"
  -set-ports=false
  -exit-on-error
)

if ! command -v goreman >/dev/null 2>&1; then
  echo "Error: bin/dev requires goreman on PATH." >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "Error: bin/dev requires Node.js and npm on PATH." >&2
  exit 1
fi

if ! command -v watchman >/dev/null 2>&1; then
  echo "Error: bin/dev requires watchman on PATH." >&2
  exit 1
fi

if ! command -v watchman-make >/dev/null 2>&1; then
  echo "Error: bin/dev requires watchman-make on PATH." >&2
  exit 1
fi

case "${1:-}" in
  --http)
    dev_mode="http"
    shift
    ;;
  --https)
    shift
    ;;
esac

if [[ "$dev_mode" == "https" ]]; then
  if ! command -v caddy >/dev/null 2>&1; then
    echo "Error: bin/dev requires caddy on PATH. Use --http to run without TLS." >&2
    exit 1
  fi

  if ! command -v tailscale >/dev/null 2>&1; then
    echo "Error: bin/dev requires tailscale on PATH. Use --http to run without TLS." >&2
    exit 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: bin/dev requires jq on PATH. Use --http to run without TLS." >&2
    exit 1
  fi

  if ! tailscale_status="$(tailscale status --json)"; then
    echo "Error: unable to read Tailscale status." >&2
    exit 1
  fi

  if ! tailscale_host="$(
    jq -er '.Self.DNSName | strings | sub("\\.$"; "") | select(length > 0)' \
      <<<"$tailscale_status"
  )"; then
    echo "Error: unable to determine this machine's Tailscale FQDN." >&2
    exit 1
  fi

  if ! tailscale_ip="$(
    jq -er '[.Self.TailscaleIPs[] | select(contains(":") | not)] | first | select(length > 0)' \
      <<<"$tailscale_status"
  )"; then
    echo "Error: unable to determine this machine's Tailscale IPv4 address." >&2
    exit 1
  fi

  export APP_HOST="$tailscale_host"
  export VXPIPE_TAILSCALE_IP="$tailscale_ip"
  export VXPIPE_CONSOLE_ASSETS_PORT="5174"
  export VXPIPE_DEV_TLS="caddy"

  caddy_runtime_dir="$repo_root/tmp/caddy"
  caddy_runtime_config="$caddy_runtime_dir/config.json"
  mkdir -p "$caddy_runtime_dir"

  if ! caddy adapt \
    --config "$repo_root/Caddyfile" \
    --adapter caddyfile \
    --pretty >"$caddy_runtime_config"; then
    echo "Error: unable to render the Caddy runtime configuration." >&2
    exit 1
  fi

  if ! caddy validate --config "$caddy_runtime_config"; then
    echo "Error: generated Caddy runtime configuration is invalid." >&2
    exit 1
  fi

  if ! sudo -v; then
    echo "Error: root access is required to run Caddy with Tailscale certificates." >&2
    exit 1
  fi

  processes+=(caddy)
fi

if [[ $# -gt 0 ]]; then
  echo "Usage: bin/dev [--http | --https]" >&2
  exit 1
fi

if [[ -f "$repo_root/.env" ]]; then
  goreman_args+=(-env "$repo_root/.env")
fi

exec goreman "${goreman_args[@]}" start "${processes[@]}"
