#!/usr/bin/env python3
"""Apply the reviewed CPU session-thread patch to pinned Ortex sources."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    root = Path(__file__).resolve().parent.parent
    dependency = root / 'deps/ortex'
    patch = root / 'patches/ortex/session-threads.patch'
    manifest = json.loads(patch.with_suffix('.json').read_text())
    revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=dependency, text=True).strip()
    if revision != manifest['revision'] or digest(patch) != manifest['patch_sha256']:
        raise ValueError('Ortex revision or patch checksum differs from the reviewed manifest')
    previous = manifest.get('previous')
    if previous:
        upgrade = patch.parent / previous['patch_file']
        if digest(upgrade) != previous['patch_sha256']:
            raise ValueError('Ortex upgrade patch checksum differs from the reviewed manifest')
    batch = manifest['batch']
    batch_patch = patch.parent / batch['patch_file']
    if digest(batch_patch) != batch['patch_sha256']:
        raise ValueError('Ortex batch patch checksum differs from the reviewed manifest')
    actual = {name: digest(dependency / name) for name in batch['files']
              if (dependency / name).exists()}
    if actual == batch['files']:
        print('Ortex CPU and batch patch verified')
        return
    states = [
        ({name: hashes['original'] for name, hashes in manifest['files'].items()}, [patch, batch_patch]),
        ({name: hashes['patched'] for name, hashes in manifest['files'].items()}, [batch_patch]),
    ]
    if previous:
        states.append((previous['files'], [upgrade, batch_patch]))
    for known, steps in states:
        if actual == known:
            for step in steps:
                subprocess.run(['git', 'apply', '--check', str(step)], cwd=dependency, check=True)
                subprocess.run(['git', 'apply', str(step)], cwd=dependency, check=True)
            break
    else:
        raise ValueError('Ortex sources differ from reviewed states; preserve changes and review the patch')
    if any(digest(dependency / name) != expected for name, expected in batch['files'].items()):
        raise ValueError('Ortex batch patch result failed checksum verification')
    print('Ortex CPU and batch patch applied and verified')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'Ortex patch preparation failed: {error}', file=sys.stderr)
        sys.exit(1)
