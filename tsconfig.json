{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@vxpipe/core": ["./packages/core/src/index.ts"],
      "@vxpipe/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/react/.storybook/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist", "**/node_modules", "**/storybook-static"]
}
