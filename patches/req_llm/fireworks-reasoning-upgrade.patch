+  defp put_native_refusals(meta, chunks) do
+    refusals =
+      for %StreamChunk{type: :meta, metadata: %{native_refusal: value}} <- chunks, do: value
+
+    if refusals == [], do: meta, else: Map.put(meta, :refusals, refusals)
+  end
+
+  defp put_router_model(provider_meta, chunks, provider)
+       when provider in [:openrouter, :zenmux] do
+    models =
+      chunks
+      |> Enum.flat_map(fn
+        %StreamChunk{type: :meta, metadata: %{router_response_model: model}} -> [model]
+        _chunk -> []
+      end)
+      |> Enum.uniq()
+
+    reported =
+      case models do
+        [model] when is_binary(model) and model != "" -> model
+        _unknown_or_inconsistent -> nil
+      end
+
+    Map.put(provider_meta, :router_response_model, reported)
+  end
+
+  defp put_router_model(provider_meta, _chunks, _provider), do: provider_meta
