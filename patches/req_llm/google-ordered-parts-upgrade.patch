+      not is_nil(google_metadata_count(metadata, "thoughtsTokenCount"))
+    %{
+      input: not is_nil(google_metadata_count(metadata, "promptTokenCount")),
+      output: reasoning_known? and not is_nil(google_metadata_count(metadata, "candidatesTokenCount"))
+    }
+  end
