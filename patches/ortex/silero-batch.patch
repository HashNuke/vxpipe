+// Fused CPU inference for the pinned Silero graph. State is 64 context samples
+// followed by two layers of 128 recurrent values, all little-endian f32.
+use crate::model::OrtexModel;
+use ndarray::{arr0, Array2, Array3};
+use rustler::{Binary, Env, Error, NifResult, OwnedBinary, ResourceArc, Term};
+use std::convert::TryInto;
+
+const CONTEXT: usize = 64;
+const WINDOW: usize = 512;
+const HIDDEN: usize = 128;
+const STATE_BYTES: usize = (CONTEXT + 2 * HIDDEN) * 4;
+
+fn read_float(bytes: &[u8]) -> NifResult<f32> {
+    let value = f32::from_le_bytes(bytes.try_into().map_err(|_| Error::BadArg)?);
+    if value.is_finite() {
+        Ok(value)
+    } else {
+        Err(Error::BadArg)
+    }
+}
+
+#[rustler::nif(schedule = "DirtyCpu")]
+pub fn silero_batch<'a>(
+    env: Env<'a>,
+    model: ResourceArc<OrtexModel>,
+    rows: Term<'a>,
+) -> NifResult<Vec<(f64, Binary<'a>)>> {
+    let mut items = Vec::with_capacity(16);
+    let mut rest = rows;
+    while !rest.is_empty_list() {
+        let (row, tail) = rest.list_get_cell()?;
+        rest = tail;
+        if items.len() == 16 {
+            return Err(Error::BadArg);
+        }
+        let (pcm, state) = row.decode::<(Binary, Binary)>()?;
+        if pcm.len() != WINDOW * 2 || state.len() != STATE_BYTES {
+            return Err(Error::BadArg);
+        }
+        items.push((pcm, state));
+    }
+    let batch = items.len();
+    if batch == 0 {
+        return Err(Error::BadArg);
+    }
+    let mut x = Array2::zeros((batch, CONTEXT + WINDOW));
+    let mut h = Array3::zeros((2, batch, HIDDEN));
+    for (i, (pcm, state)) in items.iter().enumerate() {
+        for (j, bytes) in state.as_slice().chunks_exact(4).enumerate() {
+            let v = read_float(bytes)?;
+            if j < CONTEXT {
+                x[[i, j]] = v;
+            } else {
+                let k = j - CONTEXT;
+                h[[k / HIDDEN, i, k % HIDDEN]] = v;
+            }
+        }
+        for (j, bytes) in pcm.as_slice().chunks_exact(2).enumerate() {
+            x[[i, CONTEXT + j]] = i16::from_le_bytes([bytes[0], bytes[1]]) as f32 / 32768.0;
+        }
+    }
+    let sample_rate = arr0(16000_i64);
+    let inputs = ort::inputs![x.view(), h.view(), sample_rate.view()].map_err(|_| Error::BadArg)?;
+    let outputs = model.session.run(inputs).map_err(|_| Error::BadArg)?;
+    if outputs.len() != 2 {
+        return Err(Error::BadArg);
+    }
+    let scores = outputs[0]
+        .try_extract_tensor::<f32>()
+        .map_err(|_| Error::BadArg)?;
+    let hidden = outputs[1]
+        .try_extract_tensor::<f32>()
+        .map_err(|_| Error::BadArg)?;
+    if scores.shape() != [batch, 1] || hidden.shape() != [2, batch, HIDDEN] {
+        return Err(Error::BadArg);
+    }
+    let mut results = Vec::with_capacity(batch);
+    for i in 0..batch {
+        let score = scores[[i, 0]];
+        if !(0.0..=1.0).contains(&score) {
+            return Err(Error::BadArg);
+        }
+        let mut state = OwnedBinary::new(STATE_BYTES).ok_or(Error::BadArg)?;
+        for (j, dst) in state.as_mut_slice().chunks_exact_mut(4).enumerate() {
+            let v = if j < CONTEXT {
+                x[[i, WINDOW + j]]
+            } else {
+                let k = j - CONTEXT;
+                hidden[[k / HIDDEN, i, k % HIDDEN]]
+            };
+            if !v.is_finite() {
+                return Err(Error::BadArg);
+            }
+            dst.copy_from_slice(&v.to_le_bytes());
+        }
+        results.push((score as f64, state.release(env)));
+    }
+    Ok(results)
+}
