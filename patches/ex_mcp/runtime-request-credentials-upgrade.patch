   def receive_message(%__MODULE__{} = _state) do
     {:error, :not_connected}
+  end
+
+  defp receive_sse_message(%{sse_pid: sse_pid} = state, monitor) do
+    receive do
+      {:sse_event, ^sse_pid, %{data: data} = event} ->
+        send(sse_pid, {:sse_event_ack, self()})
+
+        # The enhanced SSE client sends structured events
+        event_id = Map.get(event, :id)
+        new_state = if event_id, do: %{state | last_event_id: event_id}, else: state
+
+        case Jason.decode(data) do
+          {:ok, %{"type" => "keep-alive"}} ->
+            # Ignore keep-alive messages and continue receiving
+            receive_sse_message(new_state, monitor)
+
+          {:ok, message} ->
+            stream_message = %StreamMessage{payload: message, response_bytes: byte_size(data)}
+            {:ok, stream_message, new_state}
+
+          {:error, reason} ->
+            {:error, {:json_decode_error, reason}}
+        end
+
+      {:sse_connected, ^sse_pid} ->
+        receive_sse_message(state, monitor)
+
+      {:sse_not_supported, ^sse_pid} ->
+        {:error, :not_supported_in_sync_mode}
+
+      {:sse_error, ^sse_pid, reason} ->
+        {:error, {:sse_error, reason}}
+
+      {:sse_closed, ^sse_pid} ->
+        # A clean EOF resumes inside SSEClient; it does not retire this session.
+        receive_sse_message(state, monitor)
+
+      {:DOWN, ^monitor, :process, ^sse_pid, _reason} ->
+        {:error, :connection_closed}
+    end
