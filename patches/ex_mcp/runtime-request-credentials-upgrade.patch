+  @doc false
+  def start_owned_task(supervisor, perform, timeout) when is_pid(supervisor) do
+    caller = self()
+    deadline = System.monotonic_time(:millisecond) + timeout
+
+    guard =
+      Supervisor.child_spec(
+        {Task, fn -> owned_task_guard(caller, deadline) end},
+        restart: :temporary,
+        shutdown: :brutal_kill
+      )
+
+    with {:ok, guardian} <- DynamicSupervisor.start_child(supervisor, guard) do
+      start_owned_worker(supervisor, guardian, caller, perform)
+    end
+  catch
+    :exit, _reason -> {:error, :transport_supervisor_unavailable}
+  end
+
+  defp start_owned_worker(supervisor, guardian, caller, perform) do
+    child =
+      Supervisor.child_spec(
+        {Task,
+         fn ->
+           Process.link(guardian)
+
+           receive do
+             {:ex_mcp_work, ^caller, reference} ->
+               send(guardian, {:ex_mcp_bind, self()})
+
+               receive do
+                 {:ex_mcp_run, ^guardian} -> send(caller, {reference, perform.()})
+               end
+           end
+         end},
+        restart: :temporary,
+        shutdown: :brutal_kill
+      )
+
+    case DynamicSupervisor.start_child(supervisor, child) do
+      {:ok, pid} ->
+        reference = Process.monitor(pid)
+        send(pid, {:ex_mcp_work, caller, reference})
+
+        {:ok,
+         %Task{pid: pid, ref: reference, owner: caller, mfa: {__MODULE__, :start_owned_task, 3}}}
+
+      {:error, _reason} ->
+        Process.exit(guardian, :kill)
+        {:error, :transport_supervisor_unavailable}
+    end
+  catch
+    :exit, _reason ->
+      Process.exit(guardian, :kill)
+      {:error, :transport_supervisor_unavailable}
+  end
+
+  defp owned_task_guard(caller, deadline) do
+    caller_ref = Process.monitor(caller)
+
+    receive do
+      {:ex_mcp_bind, worker} ->
+        if System.monotonic_time(:millisecond) >= deadline,
+          do: exit({:shutdown, :owned_task_timeout})
+
+        if not Process.alive?(caller), do: exit({:shutdown, :owned_task_cancelled})
+        worker_ref = Process.monitor(worker)
+        send(worker, {:ex_mcp_run, self()})
+        await_owned_task(caller_ref, worker_ref, deadline)
+
+      {:DOWN, ^caller_ref, :process, _pid, _reason} ->
+        exit({:shutdown, :owned_task_cancelled})
+    after
+      max(deadline - System.monotonic_time(:millisecond), 0) ->
+        exit({:shutdown, :owned_task_timeout})
+    end
+  end
+
+  defp await_owned_task(caller_ref, worker_ref, deadline) do
+    receive do
+      {:DOWN, ^caller_ref, :process, _pid, _reason} ->
+        exit({:shutdown, :owned_task_cancelled})
+
+      {:DOWN, ^worker_ref, :process, _pid, _reason} ->
+        :ok
+    after
+      max(deadline - System.monotonic_time(:millisecond), 0) ->
+        exit({:shutdown, :owned_task_timeout})
+    end
