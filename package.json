{
  "name": "vxpipe-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
