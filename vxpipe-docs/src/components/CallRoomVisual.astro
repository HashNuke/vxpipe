---
import '../styles/call-room.css';
---

<figure
  class="crv"
  role="img"
  aria-label="Animated diagram of a VxPipe call room: external audio enters over a pseudo wire into the caller participant, whose speech-to-text capability feeds the agent participant; the agent answers back through model inference, text-to-speech, and guardrails, with caller and agent alternating turns."
>
  <div class="crv-room">
    <header class="crv-room-head">
      <span class="crv-room-title">call room</span>
      <span class="crv-live"><span class="crv-live-dot" aria-hidden="true"></span>live</span>
    </header>

    <div class="crv-grid">
      <div class="crv-side">
        <div class="crv-external">
          <span class="crv-ext-tag">external</span>
          <span class="crv-ext-name">pseudo wire · audio&nbsp;in</span>
        </div>
        <div class="crv-wire" aria-hidden="true">
          <span class="crv-wire-dot"></span>
        </div>

        <section class="crv-participant crv-participant--caller" aria-label="caller participant">
          <header class="crv-p-head">
            <span class="crv-avatar crv-avatar--caller" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="8" r="3.6" />
                <path d="M4.8 19.4c1.4-3.4 4.1-5 7.2-5s5.8 1.6 7.2 5" />
              </svg>
            </span>
            <span class="crv-p-name">caller</span>
            <span class="crv-p-tag">participant</span>
          </header>
          <div class="crv-eq crv-eq--caller" aria-hidden="true">
            <span style="--i: 0"></span><span style="--i: 1"></span><span style="--i: 2"></span><span
              style="--i: 3"></span><span style="--i: 4"></span>
          </div>
          <p class="crv-speaking crv-speaking--caller"><span aria-hidden="true"></span>speaking</p>
          <ul class="crv-caps">
            <li class="crv-cap crv-cap--caller" style="--d: 0s">audio input</li>
            <li class="crv-cap crv-cap--caller" style="--d: 0.7s">speech-to-text</li>
          </ul>
        </section>
      </div>

      <div class="crv-lane" aria-hidden="true">
        <span class="crv-lane-track"></span>
        <span class="crv-lane-dot crv-lane-dot--out"></span>
        <span class="crv-lane-dot crv-lane-dot--back"></span>
        <span class="crv-turn crv-turn--caller">caller turn</span>
        <span class="crv-turn crv-turn--agent">agent turn</span>
      </div>

      <section class="crv-participant crv-participant--agent" aria-label="agent participant">
        <header class="crv-p-head">
          <span class="crv-avatar crv-avatar--agent" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <rect x="6" y="7" width="12" height="10" rx="3" />
              <circle cx="10" cy="12" r="0.6" fill="currentColor" />
              <circle cx="14" cy="12" r="0.6" fill="currentColor" />
              <path d="M12 7V4.5" />
              <circle cx="12" cy="3.6" r="0.7" fill="currentColor" />
            </svg>
          </span>
          <span class="crv-p-name">agent</span>
          <span class="crv-p-tag">participant</span>
        </header>
        <div class="crv-eq crv-eq--agent" aria-hidden="true">
          <span style="--i: 4"></span><span style="--i: 3"></span><span style="--i: 2"></span><span
            style="--i: 1"></span><span style="--i: 0"></span>
        </div>
        <p class="crv-speaking crv-speaking--agent"><span aria-hidden="true"></span>speaking</p>
        <ul class="crv-caps">
          <li class="crv-cap crv-cap--agent" style="--d: 0s">model inference</li>
          <li class="crv-cap crv-cap--agent" style="--d: 0.7s">text-to-speech</li>
          <li class="crv-cap crv-cap--agent" style="--d: 1.4s">guardrails</li>
        </ul>
      </section>
    </div>

    <footer class="crv-room-foot">
      <span>one room</span><i aria-hidden="true">·</i>
      <span>caller + agent participants</span><i aria-hidden="true">·</i>
      <span>composable capabilities</span>
    </footer>
  </div>
</figure>
