{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HashNuke/vxpipe/main/integrations/schema/schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "maxLength": 240
    },
    "website_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/@?#]+(?:/[^#]*)?$",
      "maxLength": 2048
    },
    "icon_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/@?#]+(?:/[^#]*)?$",
      "maxLength": 2048,
      "description": "Declared landing-page favicon. Required for MCPs; native providers without a declared icon may omit it."
    },
    "documentation_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/@?#]+(?:/[^#]*)?$",
      "maxLength": 2048,
      "description": "Optional MCP documentation link; required for native providers."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "not": {
              "enum": [
                "connected",
                "search"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "minimum_vxpipe_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "maximum_vxpipe_version_exclusive": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "availability": {
      "enum": [
        "available",
        "preview",
        "retired"
      ]
    },
    "kind": {
      "enum": [
        "mcp",
        "provider"
      ]
    },
    "connection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "mcp"
            },
            "transport": {
              "const": "streamable_http"
            },
            "endpoint": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$",
              "maxLength": 2048
            },
            "authentication": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "oauth2"
                    },
                    "registration": {
                      "enum": [
                        "discover",
                        "cimd",
                        "dcr",
                        "preregistered"
                      ]
                    },
                    "scopes": {
                      "type": "array",
                      "maxItems": 50,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  },
                  "required": [
                    "type",
                    "registration"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "bearer",
                        "basic"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "api_key"
                    },
                    "header_name": {
                      "type": "string",
                      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                    }
                  },
                  "required": [
                    "type",
                    "header_name"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "type",
            "transport",
            "endpoint",
            "authentication"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "builtin"
            },
            "provider_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "type",
            "provider_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "setup_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/@?#]+(?:/[^#]*)?$",
      "maxLength": 2048,
      "description": "Optional link to configure or register this MCP integration."
    },
    "setup_notes": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1,
      "description": "Optional plain-text setup guidance displayed above Setup and Documentation links."
    }
  },
  "required": [
    "schema_version",
    "name",
    "website_url",
    "categories",
    "availability",
    "kind",
    "connection"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcp"
          }
        }
      },
      "then": {
        "properties": {
          "connection": {
            "type": "object",
            "properties": {
              "type": {
                "const": "mcp"
              },
              "transport": {
                "const": "streamable_http"
              },
              "endpoint": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$",
                "maxLength": 2048
              },
              "authentication": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "oauth2"
                      },
                      "registration": {
                        "enum": [
                          "discover",
                          "cimd",
                          "dcr",
                          "preregistered"
                        ]
                      },
                      "scopes": {
                        "type": "array",
                        "maxItems": 50,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      }
                    },
                    "required": [
                      "type",
                      "registration"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "none",
                          "bearer",
                          "basic"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "api_key"
                      },
                      "header_name": {
                        "type": "string",
                        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                      }
                    },
                    "required": [
                      "type",
                      "header_name"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "type",
              "transport",
              "endpoint",
              "authentication"
            ],
            "additionalProperties": false
          },
          "categories": {
            "items": {
              "properties": {
                "id": {
                  "not": {
                    "enum": [
                      "ai",
                      "telephony"
                    ]
                  }
                }
              }
            }
          }
        },
        "required": [
          "icon_url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "provider"
          }
        }
      },
      "then": {
        "properties": {
          "connection": {
            "type": "object",
            "properties": {
              "type": {
                "const": "builtin"
              },
              "provider_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "type",
              "provider_id"
            ],
            "additionalProperties": false
          },
          "categories": {
            "items": {
              "properties": {
                "id": {
                  "enum": [
                    "ai",
                    "telephony"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "minimum_vxpipe_version",
          "documentation_url"
        ]
      }
    }
  ]
}
