# Browser-visible endpoint used by the Pipecat Small WebRTC transport.
VITE_VXPIPE_RTVI_OFFER_URL=/api/rtvi/offer

# Optional development server bind host. A resolvable FQDN is supported.
APP_HOST=

# Server-side Vite proxy target. Do not put credentials in this file.
VXPIPE_GATEWAY_URL=http://127.0.0.1:4000
