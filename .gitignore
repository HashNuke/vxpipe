# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# Worktree-local environment loaded only by Goreman and its child processes.
/.env.dev

# Local checkpoint notes created by bin/create-labnotes.
/labnotes/

# The Starlight documentation site's local and generated files.
/docs/.astro/
/docs/dist/
/docs/node_modules/

# The Vite/Storybook samples package's local and generated files.
/samples/dist/
/samples/node_modules/
/samples/storybook-static/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez
