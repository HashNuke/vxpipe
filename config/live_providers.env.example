# Copy to ~/.config/vxpipe/live_providers.env. Replace placeholders only for providers you run.
# bin/livetests run loads this file for its child mix test process.
# This file uses shell KEY=value syntax. Do not commit your filled copy.

# AI model and speech providers
OPENAI_API_KEY=todo
GEMINI_API_KEY=todo
ZENMUX_API_KEY=todo
DEEPGRAM_API_KEY=todo
DEEPSEEK_API_KEY=todo
OPENROUTER_API_KEY=todo
FIREWORKS_API_KEY=todo

# Cartesia STT and TTS are available; select each live test file individually.
CARTESIA_API_KEY=todo
# ElevenLabs realtime STT and TTS share one API key.
ELEVENLABS_API_KEY=todo

# Telephony live tests (Twilio and Telnyx)
# Optional. By default bin/livetests run starts this machine's
# vxp-test-<machine> Tailscale Funnel (see the TAILSCALE_* settings below) and
# sets this URL itself. Set it only to use another public HTTPS origin, such as
# a reverse proxy forwarding to TELEPHONY_TEST_PORT (default 4600); Tailscale is
# then not managed. Separate from the app's APP_HOST / TELEPHONY_HOST settings.
TELEPHONY_TEST_PUBLIC_URL=https://todo

# Twilio and Telnyx. bin/livetests telephony:provision finds or creates this
# machine's two Telnyx numbers, Telnyx application and Twilio number; telephony
# runs discover them, so no phone numbers or IDs go here. Telnyx is required:
# its two numbers call each other for every telephony test not about Twilio.
# Twilio is optional and used only by Twilio's own tests (live_twilio).
# Twilio Account SID (AC...) and auth token from the Console home page. The
# account must be upgraded (not trial) and have an approved Trust Hub
# compliance profile to buy a number. The auth token also verifies webhooks.
TWILIO_ACCOUNT_SID=todo
TWILIO_AUTH_TOKEN=todo
# Telnyx API key (KEY...) from API Keys, and the base64 Ed25519 public key from
# Keys & Credentials > Public Key, which verifies Telnyx webhooks.
TELNYX_API_KEY=todo
TELNYX_PUBLIC_KEY=todo

# Tailscale OAuth client for the per-machine vxp-test-<machine> Funnel node used
# by live telephony tests. Create it with the Auth Keys (write) scope and tag
# tag:vxp-test; see docs/live-telephony-harness.md for the one-time policy setup.
TAILSCALE_CLIENT_ID=todo
TAILSCALE_CLIENT_SECRET=todo
