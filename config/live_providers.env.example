# Copy to ~/.config/vxpipe/live_providers.env. Replace placeholders only for providers you run.
# bin/livetests run loads this file for its child mix test process.
# This file uses shell KEY=value syntax. Do not commit your filled copy.
# TELEPHONY_TEST_PUBLIC_URL includes the required https:// scheme.

# AI model and speech providers
OPENAI_API_KEY=todo
GEMINI_API_KEY=todo
ZENMUX_API_KEY=todo
DEEPGRAM_API_KEY=todo
DEEPSEEK_API_KEY=todo
OPENROUTER_API_KEY=todo
FIREWORKS_API_KEY=todo

# Cartesia STT and TTS are available; select each live test file individually.
CARTESIA_API_KEY=todo
# ElevenLabs realtime STT and TTS share one API key.
ELEVENLABS_API_KEY=todo

# Telephony live tests (Twilio and Telnyx)
# Public HTTPS origin, optionally with a path prefix, that reaches this machine.
# The tests build each call's webhook (https://) and media stream (wss://) URLs
# under it, so no per-provider URL settings are needed. This is test-only and is
# separate from the app's APP_HOST / TELEPHONY_HOST runtime settings.
TELEPHONY_TEST_PUBLIC_URL=https://todo

# Twilio outbound voice test.
# Account SID (AC...) and auth token from the Console home page. The auth token
# also verifies Twilio webhook signatures.
TWILIO_ACCOUNT_SID=todo
TWILIO_AUTH_TOKEN=todo
# Caller ID: a voice-capable Twilio number in E.164 form, such as +14155550100.
TWILIO_TEST_FROM=todo
# A phone you own. Trial accounts must verify it under Verified Caller IDs, and
# Voice Geo Permissions must allow its country. It rings briefly.
TWILIO_TEST_DESTINATION=todo

# Telnyx outbound voice test.
# API key (KEY...) from API Keys.
TELNYX_API_KEY=todo
# Base64 Ed25519 public key from Keys & Credentials > Public Key. It verifies
# Telnyx webhook signatures.
TELNYX_PUBLIC_KEY=todo
# Voice API Application (Call Control App) ID. Attach an Outbound Voice Profile
# that allows the destination country.
TELNYX_APP_ID=todo
# Caller ID: a Telnyx number assigned to that application, in E.164 form.
TELNYX_TEST_FROM=todo
# A phone you own. It rings briefly.
TELNYX_TEST_DESTINATION=todo

# Tailscale OAuth client for the per-machine vxp-test-<machine> Funnel node used
# by live telephony tests. Create it with the Auth Keys (write) scope and tag
# tag:vxp-test; see docs/live-telephony-harness.md for the one-time policy setup.
TAILSCALE_CLIENT_ID=todo
TAILSCALE_CLIENT_SECRET=todo
