{
  "name": "@vxpipe/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vxpipe React components and an interactive Storybook prototype.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@vxpipe/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "storybook": "10.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.6"
  }
}
