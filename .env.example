# Optional overrides loaded into every process started by Goreman.
# HTTPS development derives APP_HOST from Tailscale automatically.
# APP_HOST=machine.tailnet.ts.net

# Required by the development Deepgram Flux speech-to-text capability.
# DEEPGRAM_API_KEY=replace-with-a-development-key

# Required by the development Gemini model-inference capability.
# GEMINI_API_KEY=replace-with-a-development-key

# Optional local model fixture. Use true/success, delay, failure, or missing.
# When enabled, GEMINI_API_KEY is not required and diagnostics can arm the next result.
# VXPIPE_DEV_MODEL_FIXTURE=true

# Used by Vite only when running the frontend without Caddy.
VXPIPE_GATEWAY_URL=http://127.0.0.1:4000
