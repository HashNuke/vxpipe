# Optional overrides loaded into every process started by Goreman.
# Tenant-provider encryption and platform settings are catalogued in env.sample.
# This legacy development sample remains until the tenant voice-flow cutover.
# HTTPS development derives APP_HOST and Phoenix TLS settings from Tailscale automatically.
# APP_HOST=machine.tailnet.ts.net

# Optional database override. Development defaults to vxpipe_dev on localhost.
# VXPIPE_DATABASE_URL=postgres://localhost/vxpipe_dev

# Required by the development Deepgram Flux speech-to-text capability.
# DEEPGRAM_API_KEY=replace-with-a-development-key

# Required by the development Gemini model-inference capability.
# GEMINI_API_KEY=replace-with-a-development-key

# Optional local model fixture. Use true/success, delay, failure, or missing.
# When enabled, GEMINI_API_KEY is not required and diagnostics can arm the next result.
# VXPIPE_DEV_MODEL_FIXTURE=true

# Optional local Morse TTS profile for typed Console input. This disables browser STT and
# removes the Deepgram credential requirement. Pair with VXPIPE_DEV_MODEL_FIXTURE=true for
# a fully local call; direct Morse STT requires linear16 PCM rather than browser Opus.
# VXPIPE_DEV_SPEECH_PROFILE=morse

# Optional development recording. Requires PostgreSQL and an S3-compatible bucket.
# ExAws reads credentials through its standard provider chain; never commit real values here.
# VXPIPE_RECORDING_ENABLED=true
# STORAGE_BUCKET=vxpipe-call-artifacts
# AWS_REGION=us-east-1
# AWS_ENDPOINT=http://127.0.0.1:9000
