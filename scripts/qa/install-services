#!/usr/bin/env bash
set -euo pipefail

checkout="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
service_sources="$checkout/scripts/qa"
release="$checkout/_build/prod/rel/vxpipe"

if [[ $(id -u) == 0 ]]; then
  echo "Run as the checkout owner; this script uses sudo to install system services." >&2
  exit 1
fi

test -x "$release/bin/migrate"
test -f "$checkout/.env"
docker_path="$(command -v docker)"
caddy_path="$(command -v caddy)"

"$docker_path" build --file "$service_sources/Dockerfile" \
  --build-arg "APP_UID=$(id -u)" --build-arg "APP_GID=$(id -g)" \
  --tag vxpipe:local "$release"
"$caddy_path" validate --config "$service_sources/vxpipe.caddy" --adapter caddyfile

rendered="$(mktemp -d)"
trap 'rm -rf -- "$rendered"' EXIT
python3 - "$service_sources" "$rendered" "$checkout" "$(id -un)" "$(id -gn)" \
  "$(id -u)" "$(id -g)" "$docker_path" "$caddy_path" <<'PY'
from pathlib import Path
import sys

source, target, *values = sys.argv[1:]
keys = ["CHECKOUT", "USER", "GROUP", "UID", "GID", "DOCKER", "CADDY"]
for name in ["vxpipe.service", "caddy.service"]:
    content = (Path(source) / name).read_text()
    for key, value in zip(keys, values, strict=True):
        content = content.replace("@" + key + "@", value)
    (Path(target) / name).write_text(content)
PY

systemd-analyze verify "$rendered/vxpipe.service" "$rendered/caddy.service"
sudo install -d -m 755 /etc/caddy/sites-enabled
if ! sudo test -e /etc/caddy/Caddyfile; then
  sudo install -m 644 "$service_sources/Caddyfile" /etc/caddy/Caddyfile
fi
sudo install -m 644 "$service_sources/vxpipe.caddy" /etc/caddy/sites-enabled/vxpipe.caddy
sudo "$caddy_path" validate --config /etc/caddy/Caddyfile --adapter caddyfile
sudo install -m 644 "$rendered/vxpipe.service" "$rendered/caddy.service" /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable vxpipe.service caddy.service
sudo systemctl restart vxpipe.service
sudo systemctl reload-or-restart caddy.service
