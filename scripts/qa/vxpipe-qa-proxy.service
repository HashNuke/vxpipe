[Unit]
Description=HTTPS reverse proxy for Vxpipe QA
After=network-online.target vxpipe-qa.service
Wants=network-online.target

[Service]
Type=notify
User=@USER@
Group=@GROUP@
Environment=XDG_DATA_HOME=/var/lib/vxpipe-qa-proxy
Environment=XDG_CONFIG_HOME=/var/lib/vxpipe-qa-proxy
StateDirectory=vxpipe-qa-proxy
ExecStart=@CADDY@ run --config /etc/vxpipe-qa/Caddyfile --adapter caddyfile
ExecReload=@CADDY@ reload --config /etc/vxpipe-qa/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
