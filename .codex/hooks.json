{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.agents/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if exist \"%USERPROFILE%\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" (\"%USERPROFILE%\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook & exit /b)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.agents/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "if exist \"%USERPROFILE%\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" (\"%USERPROFILE%\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook & exit /b)"
          }
        ]
      }
    ]
  }
}
