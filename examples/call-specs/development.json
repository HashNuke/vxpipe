{
  "schema_version": "20261004.01",
  "name": "Development database example",
  "incoming_call": {
    "caller": "caller",
    "handled_by": "assistant"
  },
  "defaults": {
    "capabilities": {
      "model_inference": {
        "provider": "google",
        "model": "gemini-3.5-flash-lite"
      }
    }
  },
  "participants": {
    "caller": {
      "type": "human",
      "connection": {
        "service": "web",
        "mode": "receive",
        "admission": "start_call"
      }
    },
    "assistant": {
      "type": "agent",
      "prompt": "Help the caller concisely.",
      "first_message": {
        "mode": "wait_for_input"
      },
      "tools": {},
      "transfers": []
    }
  }
}
