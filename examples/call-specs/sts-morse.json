{
  "schema_version": "20261004.01",
  "name": "Morse speech-to-speech example (local only)",
  "incoming_call": {
    "caller": "caller",
    "handled_by": "assistant"
  },
  "defaults": {
    "capabilities": {}
  },
  "participants": {
    "caller": {
      "type": "human",
      "connection": {
        "service": "web",
        "mode": "receive",
        "admission": "start_call"
      }
    },
    "assistant": {
      "type": "agent",
      "prompt": "Answer briefly with Morse speech.",
      "first_message": {
        "mode": "wait_for_input"
      },
      "tools": {},
      "transfers": [],
      "capabilities": {
        "speech_to_speech": {
          "provider": "morse",
          "model": "morse",
          "options": {}
        }
      }
    }
  }
}
