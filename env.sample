# Required for tenant provider credentials: immutable ID of the current encryption key.
VXPIPE_CREDENTIAL_KEY_ID=replace-with-key-id
# Required: JSON map of key IDs to base64-encoded 32-byte random keys. Keep old versions for decryption.
VXPIPE_CREDENTIAL_KEYS='{"replace-with-key-id":"replace-with-base64-32-byte-key"}'

# Optional in development (defaults to local vxpipe_dev); required for hosted DB-backed operation.
# VXPIPE_DATABASE_URL=postgres://user:password@localhost/vxpipe
# Optional database connection pool; defaults to 10.
# VXPIPE_DATABASE_POOL_SIZE=10

# Optional development listener; defaults to localhost:4000.
# APP_HOST=localhost
# PORT=4000
# Optional development TLS; bin/dev --tailscale supplies these automatically.
# VXPIPE_DEV_TLS=phoenix
# VXPIPE_TAILSCALE_IP=100.64.0.1
# VXPIPE_DEV_TLS_CERTFILE=path/to/tls.crt
# VXPIPE_DEV_TLS_KEYFILE=path/to/tls.key

# Optional deterministic development model fixture.
# VXPIPE_DEV_MODEL_FIXTURE=true

# Optional call recording; needs PostgreSQL and an S3-compatible bucket.
# VXPIPE_RECORDING_ENABLED=true
# VXPIPE_RECORDING_S3_BUCKET=vxpipe-call-artifacts
# VXPIPE_RECORDING_S3_REGION=us-east-1
# VXPIPE_RECORDING_S3_ENDPOINT=http://127.0.0.1:9000
# Optional call-details destination; omitted values inherit corresponding recording settings.
# VXPIPE_CALL_DETAILS_S3_BUCKET=vxpipe-call-details
# VXPIPE_CALL_DETAILS_S3_REGION=us-east-1
# VXPIPE_CALL_DETAILS_S3_ENDPOINT=http://127.0.0.1:9000

# Optional platform S3 credentials when using ExAws environment authentication.
# AWS_ACCESS_KEY_ID=replace-with-s3-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
# AWS_SESSION_TOKEN=replace-with-temporary-session-token
