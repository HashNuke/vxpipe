# Required for tenant provider credentials: immutable ID of the current encryption key.
VXPIPE_CREDENTIAL_KEY_ID=replace-with-key-id
# Required: JSON map of key IDs to base64-encoded 32-byte random keys. Keep old versions for decryption.
VXPIPE_CREDENTIAL_KEYS='{"replace-with-key-id":"replace-with-base64-32-byte-key"}'

# Optional in development (defaults to local vxpipe_dev); required for hosted DB-backed operation.
# VXPIPE_DB_URL=postgres://user:password@localhost/vxpipe
# Optional URL alias, used when VXPIPE_DB_URL is absent.
# DATABASE_URL=postgres://user:password@localhost/vxpipe
# Optional database pool; defaults to 10 and overrides any URL pool_size query.
# VXPIPE_DB_POOL_SIZE=10
# Optional pool alias, used when VXPIPE_DB_POOL_SIZE is absent.
# DB_POOL_SIZE=10

# Required for the hosted Console and `mix vxpipe.login`.
# Use the public hostname; production advertises HTTPS except for an explicit loopback host.
# APP_HOST=console.example.com
# Required in production and for development with a non-loopback host or listener:
# a stable random value of at least 64 bytes. Local development uses Phoenix's development secret.
# SECRET_KEY_BASE=replace-with-random-secret
# Internal HTTP listener port; defaults to 4000.
# PORT=4000

# Optional sample call: use the public key of a tenant with provisioned Google/Deepgram credentials.
# VXPIPE_DEV_TENANT=replace-with-tenant-key
# Development defaults to localhost:4000 when APP_HOST and PORT are unset.
# Optional development TLS; bin/dev --tailscale supplies these automatically.
# VXPIPE_DEV_TLS=phoenix
# VXPIPE_TAILSCALE_IP=100.64.0.1
# VXPIPE_DEV_TLS_CERTFILE=path/to/tls.crt
# VXPIPE_DEV_TLS_KEYFILE=path/to/tls.key

# Optional shared S3 bucket for call-details JSON and recordings; requires PostgreSQL.
# STORAGE_BUCKET=vxpipe-call-artifacts
# Optional region; defaults to us-east-1.
# AWS_REGION=us-east-1
# Optional S3-compatible HTTP(S) endpoint; omit for AWS S3.
# AWS_ENDPOINT=http://127.0.0.1:9000
# Optional explicit bucket credentials; otherwise use the ExAws role credential chain.
# AWS_ACCESS_KEY_ID=replace-with-s3-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
# Required only when the supplied AWS credentials are temporary.
# AWS_SESSION_TOKEN=replace-with-temporary-session-token
# Optional recording capture; defaults to disabled. Uses the shared bucket above.
# VXPIPE_RECORDING_ENABLED=true

# Public HTTPS base URL for Telnyx/Twilio callbacks and media; setting it enables telephony ingress.
# Carrier accounts and credentials are provisioned per tenant in the database.
# VXPIPE_TELEPHONY_PUBLIC_BASE_URL=https://voice.example.com
